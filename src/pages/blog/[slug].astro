---
// One blog post (English): src/content/blog/en/<slug>.md -> /blog/<slug>/.
import type { GetStaticPaths } from 'astro';
import PostPage from '../../components/blog/PostPage.astro';
import { postStaticPaths } from '../../lib/blog';

export const getStaticPaths = (() => postStaticPaths('en')) satisfies GetStaticPaths;

const { post, translationPath } = Astro.props;
---

<PostPage post={post} translationPath={translationPath} />
