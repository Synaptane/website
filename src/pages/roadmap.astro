---
// Roadmap (English). French twin: src/pages/fr/roadmap.astro. No dates, on purpose.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Roadmap, { type RoadmapGroup } from '../components/content/Roadmap.astro';
import { SITE } from '../site';

const groups: RoadmapGroup[] = [
  {
    id: 'ai-and-tidy-up',
    title: 'AI and tidy-up',
    intro: 'Make the tidy-up measurable, with published results.',
    items: [
      {
        status: 'later',
        title: 'Publish the bench’s results',
        text: 'The scenarios of the bench that measures the tidy-up are public, and since 1.14 it produces publishable results (repeated trials, confidence intervals, costs). What remains is to publish the first results, to compare models and prompts in the open.',
      },
    ],
  },
  {
    id: 'hosted',
    title: 'Hosted offer',
    intro: 'For teams that would rather not run a server.',
    items: [
      {
        status: 'exploring',
        title: 'Synaptane, hosted',
        text: 'Under study: no date, no commitment.',
      },
    ],
  },
  {
    id: 'ideas',
    title: 'Ideas',
    intro: 'Depending on what people ask for.',
    items: [
      {
        status: 'exploring',
        title: 'Slack and Microsoft Teams',
        text: 'Search and save notes from team chat, without going through an assistant.',
      },
    ],
  },
];
---

<Base title="Roadmap" description="The Synaptane roadmap: what is planned, and what is being explored.">
  <PageHeader
    title="Roadmap"
    intro="What is planned for Synaptane, and what is being explored. There are no dates: Synaptane is maintained by one person, and priorities follow what users need."
  >
    <div class="actions">
      <Button href={SITE.discussions} variant="primary" icon="arrow-right">Propose an idea</Button>
      <Button href="/releases/" variant="quiet">What is already there: release notes</Button>
    </div>
  </PageHeader>
  <div class="container">
    <Roadmap
      lang="en"
      groups={groups}
      legend={{
        next: 'Planned for the coming versions.',
        later: 'Planned for a later version.',
        exploring: 'Being considered. It may change, or not happen.',
      }}
    />
    <aside class="cta">
      <h2>Something missing?</h2>
      <p>
        Tell me what your team needs, or support an existing idea, in{' '}
        <a href={SITE.discussions}>GitHub Discussions</a>. Report bugs in the{' '}
        <a href={`${SITE.github}/issues`}>issue tracker</a>.
      </p>
    </aside>
  </div>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-5); }
  .cta {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-5) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    max-width: 760px;
  }
  .cta h2 { font-size: 20px; }
  .cta p { color: var(--ink-2); }
</style>
