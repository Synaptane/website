---
// Roadmap (English). French twin: src/pages/fr/roadmap.astro. No dates, on purpose.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Roadmap, { type RoadmapGroup } from '../components/content/Roadmap.astro';
import { SITE } from '../site';

const groups: RoadmapGroup[] = [
  {
    id: 'account-security',
    title: 'Account security',
    intro: 'Two-factor authentication and sessions you can see and close arrived in 1.8.0. Next, a record of who changed what.',
    items: [
      {
        status: 'later',
        title: 'Audit log in the interface',
        text: 'Who changed a role, a token or a setting, and when, readable by administrators.',
      },
    ],
  },
  {
    id: 'operations',
    title: 'Operations',
    intro: 'The /metrics endpoint for Prometheus and images for ARM servers arrived in 1.9, the health page of the instance in 1.11. Next, less work for the person who runs the server.',
    items: [
      {
        status: 'later',
        title: 'Even simpler backups',
        text: 'Backups are already verified, can be encrypted and copied off-site. Setting them up should take fewer steps.',
      },
    ],
  },
  {
    id: 'ai-and-mcp',
    title: 'AI and MCP',
    intro: 'More choice of models, and results in the open.',
    items: [
      {
        status: 'next',
        title: 'More providers with automatic pricing',
        text: 'Costs are estimated automatically for Claude models only; for other models, you enter the price per million tokens. More providers will come with their prices.',
      },
      {
        status: 'later',
        title: 'Publish the bench’s results',
        text: 'The scenarios of the bench that measures the tidy-up are already public; publish its results too, to compare models and prompts in the open.',
      },
      {
        status: 'later',
        title: 'Subscription CLIs under a separate account',
        text: 'Run Claude Code and Codex under their own system account, apart from the worker.',
      },
    ],
  },
  {
    id: 'teams',
    title: 'Teams',
    intro: 'Since 1.10, a new space shows its first steps until its first tidy-up. Next, a smoother first hour for a new team.',
    items: [
      {
        status: 'later',
        title: 'Create the repository from Synaptane',
        text: 'Create the Git repository of a new space on GitHub or GitLab without leaving Synaptane.',
      },
      {
        status: 'later',
        title: 'Default role, then groups',
        text: 'A default role for the members of an organization, then groups to give access to several spaces at once.',
      },
    ],
  },
  {
    id: 'hosted',
    title: 'Hosted offer',
    intro: 'For teams that would rather not run a server.',
    items: [
      {
        status: 'exploring',
        title: 'Synaptane, hosted',
        text: 'Under study: no date, no commitment.',
      },
    ],
  },
  {
    id: 'ideas',
    title: 'Ideas',
    intro: 'Depending on what people ask for.',
    items: [
      {
        status: 'exploring',
        title: 'Imports from Notion and Confluence',
        text: 'An Obsidian vault or a zip of Markdown files can be imported since 1.10. Notion and Confluence exports would come next.',
      },
      {
        status: 'exploring',
        title: 'Slack and Microsoft Teams',
        text: 'Search and save notes from team chat, without going through an assistant.',
      },
      {
        status: 'exploring',
        title: 'Preview while editing',
        text: 'See the page as it will read while you write it. Mermaid diagrams are drawn when reading since 1.10.',
      },
      {
        status: 'exploring',
        title: 'Capture by email',
        text: 'Forward an email to a space, and it lands in the inbox.',
      },
    ],
  },
];
---

<Base title="Roadmap" description="The Synaptane roadmap: what comes next, what comes later, and what is being explored.">
  <PageHeader
    title="Roadmap"
    intro="What comes next for Synaptane, and what is being explored. There are no dates: Synaptane is maintained by one person, and priorities follow what users need."
  >
    <div class="actions">
      <Button href={SITE.discussions} variant="primary" icon="arrow-right">Propose an idea</Button>
      <Button href="/releases/" variant="quiet">What is already there: release notes</Button>
    </div>
  </PageHeader>
  <div class="container">
    <Roadmap
      lang="en"
      groups={groups}
      legend={{
        next: 'Planned for the coming versions.',
        later: 'Planned, after the items marked Next.',
        exploring: 'Being considered. It may change, or not happen.',
      }}
    />
    <aside class="cta">
      <h2>Something missing?</h2>
      <p>
        Tell me what your team needs, or support an existing idea, in{' '}
        <a href={SITE.discussions}>GitHub Discussions</a>. Bugs go to <a href={`${SITE.github}/issues`}>issues</a>.
      </p>
    </aside>
  </div>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-5); }
  .cta {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-5) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    max-width: 760px;
  }
  .cta h2 { font-size: 20px; }
  .cta p { color: var(--ink-2); }
</style>
