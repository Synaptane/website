---
// Feuille de route (français). Jumelle anglaise : src/pages/roadmap.astro. Sans dates, à dessein.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/Button.astro';
import Roadmap, { type RoadmapGroup } from '../../components/content/Roadmap.astro';
import { SITE } from '../../site';

const groups: RoadmapGroup[] = [
  {
    id: 'ia-et-rangement',
    title: 'IA et rangement',
    intro: 'Laisser chaque équipe décrire sa nuit, et rendre le rangement mesurable.',
    items: [
      {
        status: 'next',
        title: 'Des routines qui tiennent leurs propres pages',
        text: 'Depuis la 1.16, chaque routine d’un espace est un fichier de son dépôt. Ensuite : une routine qui écrit directement dans les dossiers qui lui sont confiés (un miroir, une page de synthèse), avec les garde-fous du rangement ; une mémoire gardée d’un passage à l’autre ; des routines qui passent avant ou après le rangement, et un compte rendu unique de la nuit par e-mail ou webhook. Plus tard : des routines qui lisent un service extérieur en HTTP, avec des secrets que le modèle ne voit jamais.',
      },
      {
        status: 'later',
        title: 'Publier les résultats du banc d’évaluation',
        text: 'Les scénarios du banc qui mesure le rangement sont publics, et depuis la 1.14 il produit des résultats publiables (essais répétés, intervalles de confiance, coûts). Reste à publier les premiers résultats, pour comparer modèles et consignes au grand jour.',
      },
    ],
  },
  {
    id: 'offre-hebergee',
    title: 'Offre hébergée',
    intro: 'Pour les équipes qui préfèrent ne pas gérer de serveur.',
    items: [
      {
        status: 'exploring',
        title: 'Synaptane, hébergé',
        text: "À l’étude : ni date, ni engagement.",
      },
    ],
  },
  {
    id: 'idees',
    title: 'Idées',
    intro: 'Selon la demande.',
    items: [
      {
        status: 'exploring',
        title: 'Slack et Microsoft Teams',
        text: "Chercher et garder des notes depuis la messagerie de l’équipe, sans passer par un assistant.",
      },
    ],
  },
];
---

<Base title="Feuille de route" description="La feuille de route de Synaptane : ce qui est prévu, et ce qui est à l’étude.">
  <PageHeader
    title="Feuille de route"
    intro="Ce qui est prévu pour Synaptane, et les pistes à l’étude. Pas de dates : Synaptane est maintenu par une seule personne, et les priorités suivent les besoins des utilisateurs."
  >
    <div class="actions">
      <Button href={SITE.discussions} variant="primary" icon="arrow-right">Proposer une idée</Button>
      <Button href="/fr/releases/" variant="quiet">Ce qui existe déjà : les notes de version</Button>
    </div>
  </PageHeader>
  <div class="container">
    <Roadmap
      lang="fr"
      groups={groups}
      legend={{
        next: 'Prévu pour les prochaines versions.',
        later: 'Prévu pour une version ultérieure.',
        exploring: 'Envisagé. Peut changer, ou ne pas se faire.',
      }}
    />
    <aside class="cta">
      <h2>Il vous manque quelque chose ?</h2>
      <p>
        Dites-moi ce dont votre équipe a besoin, ou soutenez une idée déjà proposée, dans les{' '}
        <a href={SITE.discussions}>Discussions GitHub</a>. Signalez les bugs dans les{' '}
        <a href={`${SITE.github}/issues`}>tickets GitHub (issues)</a>.
      </p>
    </aside>
  </div>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-5); }
  .cta {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-5) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    max-width: 760px;
  }
  .cta h2 { font-size: 20px; }
  .cta p { color: var(--ink-2); }
</style>
