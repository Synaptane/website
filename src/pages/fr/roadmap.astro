---
// Feuille de route (français). Jumelle anglaise : src/pages/roadmap.astro. Sans dates, à dessein.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/Button.astro';
import Roadmap, { type RoadmapGroup } from '../../components/content/Roadmap.astro';
import { SITE } from '../../site';

const groups: RoadmapGroup[] = [
  {
    id: 'securite-des-comptes',
    title: 'Sécurité des comptes',
    intro: 'La double authentification et les sessions visibles et révocables sont arrivées avec la 1.8.0. Ensuite, la trace de qui a changé quoi.',
    items: [
      {
        status: 'later',
        title: "Journal d’audit dans l’interface",
        text: 'Qui a changé un rôle, un jeton ou un réglage, et quand, consultable par les administrateurs.',
      },
    ],
  },
  {
    id: 'exploitation',
    title: 'Exploitation',
    intro: 'Moins de travail pour qui fait tourner le serveur.',
    items: [
      {
        status: 'next',
        title: 'Supervision',
        text: "Un point d’accès <code>/metrics</code> pour Prometheus et les outils du même genre, à côté des <code>/healthz</code> et <code>/readyz</code> existants, et une page de santé de l’instance avec des alertes système.",
      },
      {
        status: 'next',
        title: 'Image arm64',
        text: "L’image publiée pour les serveurs ARM, et plus seulement x86-64.",
      },
      {
        status: 'later',
        title: 'Des sauvegardes encore plus simples',
        text: "Les sauvegardes sont déjà vérifiées, et peuvent être chiffrées et copiées hors du serveur. Leur mise en place doit demander moins d’étapes.",
      },
    ],
  },
  {
    id: 'ia-et-mcp',
    title: 'IA et MCP',
    intro: 'Plus de choix de modèles, et des résultats publiés.',
    items: [
      {
        status: 'next',
        title: 'Plus de fournisseurs, tarifs compris',
        text: "Le coût n’est estimé automatiquement que pour les modèles Claude ; pour les autres, vous saisissez le prix par million de jetons. D’autres fournisseurs arriveront avec leurs tarifs.",
      },
      {
        status: 'later',
        title: 'Publier les résultats du banc d’évaluation',
        text: 'Les scénarios du banc qui mesure le rangement sont déjà publics ; publier aussi ses résultats, pour comparer modèles et consignes au grand jour.',
      },
      {
        status: 'later',
        title: 'Les CLI des abonnements sous un compte à part',
        text: 'Faire tourner Claude Code et Codex sous leur propre compte système, séparé du worker.',
      },
    ],
  },
  {
    id: 'equipes',
    title: 'Équipes',
    intro: 'Une première heure plus fluide pour une nouvelle équipe.',
    items: [
      {
        status: 'later',
        title: 'Créer le dépôt depuis Synaptane',
        text: "Créer le dépôt Git d’un nouvel espace sur GitHub ou GitLab sans quitter Synaptane.",
      },
      {
        status: 'later',
        title: 'Rôle par défaut, puis groupes',
        text: "Un rôle par défaut pour les membres d’une organisation, puis des groupes pour ouvrir plusieurs espaces d’un coup.",
      },
      {
        status: 'later',
        title: 'Premiers pas guidés',
        text: "Une liste d’étapes qui accompagne un nouvel espace jusqu’à son premier rangement.",
      },
    ],
  },
  {
    id: 'offre-hebergee',
    title: 'Offre hébergée',
    intro: 'Pour les équipes qui préfèrent ne pas gérer de serveur.',
    items: [
      {
        status: 'exploring',
        title: 'Synaptane, hébergé',
        text: "À l’étude : ni date, ni engagement.",
      },
    ],
  },
  {
    id: 'idees',
    title: 'Idées',
    intro: 'Selon la demande.',
    items: [
      {
        status: 'exploring',
        title: 'Imports',
        text: "Depuis Obsidian, Notion, Confluence ou une archive zip de fichiers Markdown, pièces jointes comprises.",
      },
      {
        status: 'exploring',
        title: 'Slack et Microsoft Teams',
        text: "Chercher et garder des notes depuis la messagerie de l’équipe, sans passer par un assistant.",
      },
      {
        status: 'exploring',
        title: 'Éditeur avec aperçu, et diagrammes',
        text: 'Un aperçu pendant la saisie, et des diagrammes Mermaid dans les pages.',
      },
      {
        status: 'exploring',
        title: 'Capture par e-mail',
        text: "Transférer un e-mail à un espace pour qu’il arrive dans l’inbox.",
      },
    ],
  },
];
---

<Base title="Feuille de route" description="La feuille de route de Synaptane : ce qui vient prochainement, ce qui viendra plus tard, et ce qui est à l’étude.">
  <PageHeader
    title="Feuille de route"
    intro="Ce qui attend Synaptane, et les pistes à l’étude. Pas de dates : Synaptane est maintenu par une seule personne, et les priorités suivent les besoins des utilisateurs."
  >
    <div class="actions">
      <Button href={SITE.discussions} variant="primary" icon="arrow-right">Proposer une idée</Button>
      <Button href="/fr/releases/" variant="quiet">Ce qui existe déjà : les notes de version</Button>
    </div>
  </PageHeader>
  <div class="container">
    <Roadmap
      lang="fr"
      groups={groups}
      legend={{
        next: 'Prévu pour les prochaines versions.',
        later: 'Prévu, après ce qui est marqué « Prochainement ».',
        exploring: 'Envisagé. Peut changer, ou ne pas se faire.',
      }}
    />
    <aside class="cta">
      <h2>Il vous manque quelque chose ?</h2>
      <p>
        Dites-moi ce dont votre équipe a besoin, ou soutenez une idée déjà proposée, dans les{' '}
        <a href={SITE.discussions}>Discussions GitHub</a>. Les bugs vont dans les{' '}
        <a href={`${SITE.github}/issues`}>issues</a>.
      </p>
    </aside>
  </div>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-5); }
  .cta {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-5) var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    max-width: 760px;
  }
  .cta h2 { font-size: 20px; }
  .cta p { color: var(--ink-2); }
</style>
