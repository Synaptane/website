---
// Page d'accueil (français). Jumelle anglaise : src/pages/index.astro.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Screenshot from '../../components/Screenshot.astro';
import Section from '../../components/Section.astro';
import Todo from '../../components/Todo.astro';
import { SITE } from '../../site';
---

<Base description="Synaptane est un second cerveau d'équipe auto-hébergé, stocké dans Git. Vos assistants IA le consultent par MCP, et un agent IA range leurs notes chaque nuit dans un wiki en Markdown.">
  <section class="hero container">
    <p class="status">Alpha · {SITE.version}</p>
    <h1>Le second cerveau de l'équipe, stocké dans Git.</h1>
    <p class="lead">
      Vos assistants IA le consultent et y déposent ce qu'ils apprennent, dans une inbox, par MCP.
      Chaque nuit, un agent IA range ces notes dans un wiki en Markdown et commite le résultat.
    </p>
    <div class="actions">
      <Button href="/fr/docs/admin/installation/" variant="primary" size="lg" icon="arrow-right">Installer Synaptane</Button>
      <Button href="/fr/demo/" size="lg">Essayer la démo</Button>
      <Button href={SITE.github} size="lg" iconBefore="github">GitHub</Button>
    </div>
    <Todo>Accroche : titre définitif, présentation en une phrase et appels à l'action (un seul bouton principal).</Todo>
    <Screenshot
      light="/docs/assets/screenshot-wiki-light.png"
      dark="/docs/assets/screenshot-wiki-dark.png"
      width={2000}
      height={1250}
      eager
      alt="Une page du wiki Synaptane : l'arborescence de l'espace, un tableau, un badge « vérifiée », les pages qui y renvoient et les pages proches"
    />
  </section>

  <Section id="features" title="Ce que fait Synaptane">
    <Todo>Grille des fonctionnalités (CardGrid + Card) : stockage Git, wiki Markdown, recherche plein texte et sémantique, serveur MCP, inbox et rangement nocturne, auto-hébergement.</Todo>
  </Section>

  <Section id="how-it-works" tone="alt" title="Comment ça marche">
    <Todo>La boucle : les assistants déposent des notes → inbox → rangement nocturne → commit. Reprendre /docs/assets/architecture.svg (et architecture-dark.svg).</Todo>
  </Section>

  <Section id="get-started" title="Démarrer">
    <Todo>Démarrage rapide en trois étapes, avec les commandes ci-dessous, puis des liens vers la documentation.</Todo>
    <CodeBlock title="Terminal" lang="sh" code={`git clone --branch ${SITE.version} https://github.com/synaptane/synaptane.git ~/synaptane
cd ~/synaptane
cp .env.example .env && chmod 600 .env
docker compose pull
docker compose up -d`} />
  </Section>
</Base>

<style>
  .hero { padding-block: var(--space-8) var(--space-7); }
  .status {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
  }
  h1 { max-width: 16ch; }
  .lead { margin-top: var(--space-4); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-6) 0 var(--space-5); }
  .hero :global(.screenshot) { margin-top: var(--space-6); }
</style>
