---
// Un article du blog (français) : src/content/blog/fr/<slug>.md -> /fr/blog/<slug>/.
import type { GetStaticPaths } from 'astro';
import PostPage from '../../../components/blog/PostPage.astro';
import { postStaticPaths } from '../../../lib/blog';

export const getStaticPaths = (() => postStaticPaths('fr')) satisfies GetStaticPaths;

const { post, translationPath } = Astro.props;
---

<PostPage post={post} translationPath={translationPath} />
