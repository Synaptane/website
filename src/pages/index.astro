    assistants: 'Read the extracted text',
  },
  {
    icon: 'image',
    name: 'Images',
    types: 'PNG, JPEG, GIF, WebP, AVIF, BMP, SVG',
    wiki: 'Displayed, alone or in the pages that embed them',
    search: 'Text in the image, by OCR (not SVG or AVIF)',
    assistants: 'Read the OCR text',
  },
  {
    icon: 'code',
    name: 'HTML pages',
    types: '.html .htm',
