---
// Home page (English). French twin: src/pages/fr/index.astro.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Screenshot from '../components/Screenshot.astro';
import Section from '../components/Section.astro';
import Todo from '../components/Todo.astro';
import { SITE } from '../site';
---

<Base description="Synaptane is a self-hosted team second brain stored in Git. Your AI assistants search it over MCP, and an AI agent files their notes into a plain-Markdown wiki every night.">
  <section class="hero container">
    <p class="status">Alpha · {SITE.version}</p>
    <h1>The team second brain, stored in Git.</h1>
    <p class="lead">
      Your AI assistants search it and drop what they learn into an inbox over MCP. Every night, an
      AI agent files those notes into a plain-Markdown wiki and commits the result.
    </p>
    <div class="actions">
      <Button href="/docs/admin/installation/" variant="primary" size="lg" icon="arrow-right">Install Synaptane</Button>
      <Button href="/demo/" size="lg">Try the demo</Button>
      <Button href={SITE.github} size="lg" iconBefore="github">GitHub</Button>
    </div>
    <Todo>Hero: final headline, one-sentence pitch and calls to action (keep a single primary button).</Todo>
    <Screenshot
      light="/docs/assets/screenshot-wiki-light.png"
      dark="/docs/assets/screenshot-wiki-dark.png"
      width={2000}
      height={1250}
      eager
      alt="A Synaptane wiki page: the space tree, a table, a verified badge, pages linking here and related pages"
    />
  </section>

  <Section id="features" title="What Synaptane does">
    <Todo>Feature grid (CardGrid + Card): Git storage, Markdown wiki, full-text and semantic search, MCP server, inbox and nightly tidy-up, self-hosted.</Todo>
  </Section>

  <Section id="how-it-works" tone="alt" title="How it works">
    <Todo>The loop: assistants drop notes → inbox → nightly tidy-up → commit. Reuse /docs/assets/architecture.svg (and architecture-dark.svg).</Todo>
  </Section>

  <Section id="get-started" title="Get started">
    <Todo>Quick start in three steps, with the commands below, then links to the docs.</Todo>
    <CodeBlock title="Terminal" lang="sh" code={`git clone --branch ${SITE.version} https://github.com/synaptane/synaptane.git ~/synaptane
cd ~/synaptane
cp .env.example .env && chmod 600 .env
docker compose pull
docker compose up -d`} />
  </Section>
</Base>

<style>
  .hero { padding-block: var(--space-8) var(--space-7); }
  .status {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
  }
  h1 { max-width: 16ch; }
  .lead { margin-top: var(--space-4); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-6) 0 var(--space-5); }
  .hero :global(.screenshot) { margin-top: var(--space-6); }
</style>
