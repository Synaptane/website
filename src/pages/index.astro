---
// Home page (English). French twin: src/pages/fr/index.astro.
// Facts on this page are checked against the documentation of synaptane/synaptane (README,
// docs/concepts.md, docs/guide/mcp.md, docs/guide/wiki.md, docs/admin/*.md); the comparison table against each
// product's public documentation and announcements, as of October 2026. FAQ: README (Status,
// Known limitations), docs/admin/ai.md (providers, cost and budget, what is sent) and
// .github/workflows/ci.yml (what the public CI checks). The use cases link to real pages of the
// demo (examples/acme-wiki). No testimonial or usage figure: do not add one without a source
// anyone can check.
// Order of the sections: the problem and the answer (hero, journey), what it covers (features and
// files, screenshots, use cases), the comparison (table, architecture and license), the
// objections (FAQ), then trying it (final band, get started).
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Screenshot from '../components/Screenshot.astro';
import Section from '../components/Section.astro';
import Hero from '../components/home/Hero.astro';
import Journey from '../components/home/Journey.astro';
import FeatureGrid, { type Feature } from '../components/home/FeatureGrid.astro';
import Gallery from '../components/home/Gallery.astro';
import FileFormats, { type FileFormat } from '../components/home/FileFormats.astro';
import Comparison, { type Row } from '../components/home/Comparison.astro';
import HomeIcon from '../components/home/HomeIcon.astro';
import '../components/home/home.css';
import { SITE } from '../site';
import { installCode as installCodeFor } from '../lib/install';
import { releaseLabel, releaseStatus } from '../lib/release';

const release = await releaseStatus();

// One benefit and one proof per card; the details are behind the link. Search and files have
// their own band (FileFormats), AI providers and costs are in the FAQ.
const features: Feature[] = [
  {
    icon: 'git',
    title: 'Git is the source of truth',
    text: 'Each space is a Git repository, on GitHub, GitLab, Gitea or any host: Markdown pages and your original files, one commit per change.',
    href: '/docs/admin/git/',
    linkLabel: 'Git repositories',
  },
  {
    icon: 'plug',
    title: 'Built for AI assistants',
    text: 'Claude, ChatGPT and other assistants search the wiki and save notes to it over MCP. You choose what each connection may read or write.',
    href: '/docs/guide/mcp/',
    linkLabel: 'Connect an assistant',
  },
  {
    icon: 'inbox',
    title: 'Inbox and nightly tidy-up',
    text: 'Assistants, the web UI, the API and emails from authenticated senders drop notes into an inbox. Every night an AI agent files them, with capped deletions and one-click undo.',
    href: '/docs/concepts/#tidy-up',
    linkLabel: 'How the tidy-up works',
  },
  {
    icon: 'clock',
    title: 'Scheduled routines',
    text: 'Agents that run on a schedule, such as a weekly consistency check or a Friday digest, and report in a page, the inbox, an email or a webhook.',
    href: '/docs/admin/ai/#agent-routines-per-space',
    linkLabel: 'Routines',
  },
  {
    icon: 'shield',
    title: 'Knowledge you can trust',
    text: 'Page owners, verification dates and a health tab for broken links and pages to review. Probable secrets are refused before any commit.',
    href: '/docs/guide/wiki/#verify-a-page',
    linkLabel: 'Verified pages',
  },
  {
    icon: 'users',
    title: 'Made for teams',
    text: 'Groups, roles and a default role for members, restricted spaces for HR or management, email invitations, single sign-on (OIDC, GitHub, GitLab, Google), 2FA and an audit log.',
    href: '/docs/concepts/#roles-and-permissions',
    linkLabel: 'Roles and permissions',
  },
];

// The kinds of files a space displays and searches (README "Your files, all searchable").
const formats: FileFormat[] = [
  { icon: 'markdown', name: 'Markdown pages' },
  { icon: 'file-text', name: 'PDF and scans' },
  { icon: 'slides', name: 'Word, PowerPoint, Excel' },
  { icon: 'image', name: 'Images' },
  { icon: 'code', name: 'HTML pages' },
  { icon: 'braces', name: 'CSV, JSON, code' },
  { icon: 'archive', name: 'Everything else' },
];

const installCode = installCodeFor('en');

const rows: Row[] = [
  {
    label: 'Self-hosted',
    cells: [
      { level: 'yes', text: 'Yes, with Docker Compose' },
      { level: 'no', text: 'No, cloud only' },
      { level: 'no', text: 'Rovo is cloud only; Data Center reaches end of life in 2029' },
      { level: 'yes', text: 'Yes' },
      { level: 'partial', text: 'Desktop and mobile app, no server' },
      { level: 'yes', text: 'Yes' },
    ],
  },
  {
    label: 'Your content as files you own',
    hint: 'Readable without the tool',
    cells: [
      { level: 'yes', text: 'Markdown pages and your original files (PDF, Office, images…) in your Git repository, one commit per change' },
      { level: 'partial', text: 'Through export (Markdown, HTML, PDF)' },
      { level: 'partial', text: 'Through export (PDF, Word, HTML)' },
      { level: 'partial', text: 'Through export (Markdown)' },
      { level: 'yes', text: 'Markdown files and attachments on your disk' },
      { level: 'yes', text: 'Markdown, with optional Git sync' },
    ],
  },
  {
    label: 'MCP server',
    hint: 'For Claude, ChatGPT and others',
    cells: [
      { level: 'yes', text: 'Built in: search, read, write, inbox' },
      { level: 'yes', text: 'Official, hosted by Notion' },
      { level: 'yes', text: 'Rovo MCP server (cloud)' },
      { level: 'yes', text: 'Built in since February 2026' },
      { level: 'partial', text: 'Community plugins' },
      { level: 'no', text: 'No official server' },
    ],
  },
  {
    label: 'AI that files new notes',
    hint: 'On a schedule, into the right pages',
    cells: [
      { level: 'yes', text: 'Every night, in one commit you can undo' },
      { level: 'partial', text: 'Possible with Custom Agents (Business and Enterprise plans)' },
      { level: 'partial', text: 'Possible with Rovo agents in Automation rules' },
      { level: 'no', text: 'Not built in' },
      { level: 'no', text: 'Not built in' },
      { level: 'no', text: 'Not built in' },
    ],
  },
  {
    label: 'Teams and single sign-on',
    cells: [
      { level: 'yes', text: 'Groups, audit log, 2FA; OIDC, GitHub, GitLab, Google' },
      { level: 'yes', text: 'SAML SSO on Business and Enterprise plans' },
      { level: 'yes', text: 'SSO with Atlassian Guard' },
      { level: 'yes', text: 'Sign-in through Google, Slack, Microsoft or OIDC' },
      { level: 'partial', text: 'Shared vaults with paid Sync; no SSO' },
      { level: 'yes', text: 'OIDC, SAML, LDAP and more' },
    ],
  },
  {
    label: 'Open source license',
    cells: [
      { level: 'yes', text: 'Apache-2.0' },
      { level: 'no', text: 'Proprietary' },
      { level: 'no', text: 'Proprietary' },
      { level: 'partial', text: 'BSL 1.1 (source available)' },
      { level: 'no', text: 'Proprietary, free to use' },
      { level: 'yes', text: 'AGPL-3.0' },
    ],
  },
];
---

<Base
  title="Your team's memory, in Git"
  description="Synaptane is a self-hosted team second brain in Git: Markdown and all your files, searchable. AI assistants use it over MCP; an AI agent files their notes."
>
  <Hero
    status={releaseLabel(release, 'en')}
    statusHref="/releases/"
    title="Your team's memory, in Git."
    titleMuted="Fed by your AI assistants, tidied up every night."
    lead="A self-hosted wiki for your pages and files, PDFs and scans included. Your assistants search it and save what they learn over MCP; each night, an AI agent files their notes into the right pages and commits the result."
    points={['Open source (Apache-2.0)', 'Self-hosted with Docker', 'Works without an AI provider']}
    screenshotAlt="A Synaptane wiki page: the space tree, the Backups page with its verified badge, the pages linking to it and related pages it does not link to yet"
    caption="A page of the demo wiki of Acme, a fictional IT team."
  >
    <Fragment slot="actions">
      <Button href="#get-started" variant="primary" size="lg" icon="arrow-down">Try it locally</Button>
      <Button href="/demo/" size="lg">See the demo</Button>
      <Button href={SITE.github} size="lg" variant="quiet" iconBefore="github">GitHub</Button>
    </Fragment>
  </Hero>

  <Section
    id="how-it-works"
    tone="alt"
    class="home-journey"
    eyebrow="How it works"
    title="From a conversation to the wiki, and back"
    intro="What your team explains to its assistants no longer vanishes when the chat ends. Follow one note from Tuesday afternoon to Wednesday morning."
  >
    <Journey lang="en" />
  </Section>

  <Section
    id="features"
    eyebrow="Features"
    title="A wiki your assistants read, feed and keep tidy"
  >
    <FeatureGrid items={features} />
    <FileFormats id="files" items={formats} label="Kinds of files">
      <h3>Your files, all searchable</h3>
      <p>
        Drop a PDF, a scan or a slide deck next to your pages: Synaptane shows it in the page, reads
        its text (OCR included) and makes it searchable, by words or by meaning, for you and your
        assistants.
      </p>
      <p>
        Add files from the web interface (25 MB each, or a zip), as attachments to a note from an
        assistant or to an email, or with a git push.
      </p>
      <p class="home-files-links">
        <a href="/docs/guide/wiki/#files-other-than-markdown">Files other than Markdown<span aria-hidden="true"> →</span></a>
        <a href="/docs/guide/wiki/#search">Search<span aria-hidden="true"> →</span></a>
        <a href="/demo/app/o/acme/it/p/infra/documents/">See them in the demo<span aria-hidden="true"> →</span></a>
      </p>
    </FileFormats>
  </Section>

  <Section
    id="screenshots"
    tone="alt"
    eyebrow="In practice"
    title="Inside the application"
    intro="Screenshots and examples from the demo wiki of Acme, a fictional IT team: the examples open in your browser."
  >
    <Gallery
      openLabel="(full-size image)"
      items={[
        { shot: 'search', title: 'Search', text: 'across all your spaces, by words or by meaning.', alt: 'Search results for “backup”: the matching pages with their space, path, verified badge and excerpts' },
        { shot: 'ocr', title: 'Scans:', text: 'a scanned delivery note, and its text read by OCR.', alt: 'A scanned PDF delivery note in the built-in viewer, above the text recognized by OCR' },
        { shot: 'health', title: 'Wiki health:', text: 'broken links, orphan pages, pages to review.', alt: 'The health tab of a space: pages checked, a broken link and its page, no orphan page' },
      ]}
    />
    <h3 class="home-cases-title" id="use-cases">What teams keep in it</h3>
    <ul class="home-cases">
      <li>
        <HomeIcon name="terminal" size={18} />
        <h4>Runbooks and infrastructure</h4>
        <p>Servers, network, backups and restore procedures, next to their documents: a support contract in PDF, a scanned delivery note, a hardware inventory in Excel.</p>
        <a href="/demo/app/o/acme/it/p/procedures/restore.md/">The restore procedure<span aria-hidden="true"> →</span></a>
      </li>
      <li>
        <HomeIcon name="commit" size={18} />
        <h4>Decisions and their reasons</h4>
        <p>One page per decision, with its date and its reason. Months later, anyone can ask an assistant why there are no deployments on Friday afternoons, and get the page.</p>
        <a href="/demo/app/o/acme/it/p/decisions/2026-10-no-friday-deployments.md/">A decision page<span aria-hidden="true"> →</span></a>
      </li>
      <li>
        <HomeIcon name="users" size={18} />
        <h4>Onboarding a newcomer</h4>
        <p>The checklist, the accounts to open, the security training: what a newcomer reads on day one, and asks an assistant about on day two instead of interrupting a colleague.</p>
        <a href="/demo/app/o/acme/it/p/team/onboarding.md/">The onboarding page<span aria-hidden="true"> →</span></a>
      </li>
    </ul>
  </Section>

  <Section
    id="compare"
    eyebrow="Comparison"
    title="How Synaptane compares"
    intro="Each of these tools is good at what it does. This table only covers what Synaptane is built around: your own server, files you own, assistants, and an AI that keeps the wiki tidy."
  >
    <Comparison
      caption="Synaptane compared with Notion AI, Confluence with Rovo, Outline, Obsidian and Wiki.js"
      regionLabel="Comparison table (scrolls sideways)"
      criterion="Criterion"
      columns={['Synaptane', 'Notion AI', 'Confluence + Rovo', 'Outline', 'Obsidian', 'Wiki.js']}
      levels={{ yes: 'Yes', partial: 'Partly', no: 'No' }}
      rows={rows}
    />
    <p class="home-small">
      As of October 2026, from each product's public documentation and announcements. These products
      change quickly: if something here is out of date, please <a href={SITE.discussions}>tell us on GitHub Discussions</a>.
    </p>
    <p class="home-note home-compare-import">
      <strong>Already on Notion, Confluence or Obsidian?</strong> Import a zip from a folder's menu in
      the web interface: an Obsidian vault goes in as it is; a Notion export (Markdown &amp; CSV) or a
      Confluence space exported in HTML becomes Markdown pages, with their tree and their links
      rewritten. You first see what will happen, then everything goes in one commit. <a
        href="/docs/guide/wiki/#import-obsidian-markdown-notion-or-confluence">Import guide<span aria-hidden="true"> →</span></a>
    </p>
  </Section>

  <Section
    id="architecture"
    tone="alt"
    eyebrow="Architecture and open source"
    title="Simple to run, easy to leave"
    intro="One application, one worker, PostgreSQL and your Git repositories. If you stop using Synaptane, your wiki is still a folder of Markdown pages and your original files."
    class="home-arch"
  >
      <Screenshot
        light="/docs/assets/architecture.svg"
        dark="/docs/assets/architecture-dark.svg"
        width={1040}
        height={452}
        zoom="home"
        zoomCaption="Architecture of Synaptane: the application, the worker, PostgreSQL, the Git repositories and the optional AI provider."
        alt="Architecture: AI assistants (MCP, OAuth 2.1), browsers (web UI) and scripts (REST API) reach the FastAPI app; a worker handles the nightly tidy-up, routines, Git sync, indexing and webhooks; both share PostgreSQL with pgvector and local Git working copies; the worker syncs one Git repository per space and calls an optional AI provider."
      />
      <ul class="home-arch-list">
        <li><strong>One FastAPI app</strong> serves the three interfaces: MCP for assistants, the web UI and the REST API.</li>
        <li><strong>PostgreSQL</strong> holds accounts, permissions, settings and the semantic index (pgvector). The rest can be rebuilt from the repositories.</li>
        <li><strong>A worker</strong> runs the nightly tidy-up, the routines, Git sync, indexing (with text extraction and OCR) and webhooks.</li>
        <li><strong>Backups and monitoring:</strong> a <a href="/docs/admin/backup/">verified backup every night</a>, nothing to set up; encrypted off-site in one command; a Health page, alerts, <code>/metrics</code>.</li>
      </ul>
      <div class="home-oss" id="open-source">
        <p>
          <strong>Free software.</strong> Synaptane is under the Apache License 2.0. The code, the
          documentation and this website are on GitHub, and contributions are welcome: commits are
          signed off under the Developer Certificate of Origin.
        </p>
        <ul class="home-link-list">
          <li>
            <a href={SITE.github}>
              <HomeIcon name="code" size={20} />
              <span>Read the code<span class="home-link-sub">synaptane/synaptane on GitHub</span></span>
              <HomeIcon name="external" size={16} class="home-arrow" />
            </a>
          </li>
          <li>
            <a href={`${SITE.github}/blob/main/CONTRIBUTING.md`}>
              <HomeIcon name="git" size={20} />
              <span>Contribute<span class="home-link-sub">How to propose a change</span></span>
              <HomeIcon name="external" size={16} class="home-arrow" />
            </a>
          </li>
          <li>
            <a href={SITE.discussions}>
              <HomeIcon name="discuss" size={20} />
              <span>Ask a question, share an idea<span class="home-link-sub">GitHub Discussions</span></span>
              <HomeIcon name="external" size={16} class="home-arrow" />
            </a>
          </li>
        </ul>
      </div>
  </Section>

  <Section id="faq" tone="alt" eyebrow="FAQ" title="Questions before you start">
    <div class="home-faq">
      <details>
        <summary>Which AI assistants work with it?</summary>
        <div>
          <p>
            Any assistant that speaks MCP. Synaptane is tested with Claude.ai, Claude Desktop, Claude
            Code and ChatGPT: they search and read the wiki and drop notes into the inbox. In Claude
            and ChatGPT, views let you review pages and undo a tidy-up without leaving the conversation. Claude.ai and ChatGPT need your
            instance on a public HTTPS address; Claude Code also connects to a local one, with a
            personal token.
          </p>
          <a href="/docs/guide/mcp/">Connect your AI assistant<span aria-hidden="true"> →</span></a>
        </div>
      </details>
      <details>
        <summary>Does my content go to an AI provider?</summary>
        <div>
          <p>
            Only to the provider your organization chooses, and only for the AI features: the nightly
            tidy-up and the routines send it the notes and pages they work on, semantic search sends
            text to an embedding provider. Attachment text that probably holds a secret is not sent.
            With a local model (Ollama), nothing leaves your server. Your assistants, for their part,
            see what they read, under their own provider's terms.
          </p>
          <a href="/docs/admin/ai/">AI and tidy-up<span aria-hidden="true"> →</span></a>
        </div>
      </details>
      <details>
        <summary>What does it cost?</summary>
        <div>
          <p>
            The software is free. You pay for your server and, if you use the AI features, your
            provider: Anthropic, OpenAI, Mistral, Ollama or any OpenAI-compatible API. A monthly
            budget per organization caps the spending (the form suggests €20 for a pay-per-use key);
            once it is reached, runs stop until the next month.
          </p>
          <a href="/docs/admin/ai/#cost-and-budget">Cost and budget<span aria-hidden="true"> →</span></a>
        </div>
      </details>
      <details>
        <summary>Is it ready for a real team?</summary>
        <div>
          <p>
            Synaptane is stable since v1.0.0 (latest: {SITE.version}) and follows Semantic Versioning:
            within 1.x, the REST API, the MCP tools and the configuration only change in a compatible
            way. It is maintained by one person, on a best-effort basis. Every change runs the tests, a
            dependency audit and a full Docker install, upgrade, backup and restore in
            <a href={`${SITE.github}/actions/workflows/ci.yml`}>public CI</a>. Back up before each
            upgrade.
          </p>
          <a href="/releases/">Release notes<span aria-hidden="true"> →</span></a>
        </div>
      </details>
      <details>
        <summary>Is there a hosted Synaptane?</summary>
        <div>
          <p>
            Not yet: it is being considered. If you would use one, tell us on GitHub Discussions.
          </p>
          <a href={SITE.discussions}>GitHub Discussions<span aria-hidden="true"> →</span></a>
        </div>
      </details>
    </div>
  </Section>

  <section class="container home-cta-band" aria-labelledby="cta-title">
    <div class="home-cta">
      <h2 id="cta-title">Give your assistants a memory your team owns.</h2>
      <p>Your pages and your documents, searchable, in a Git repository that stays yours. Run Synaptane on your own machine in a few minutes, or try the demo in your browser first.</p>
      <div class="home-links">
        <Button href="#get-started" variant="primary" size="lg" icon="arrow-down">Try it locally</Button>
        <Button href="/demo/" size="lg">See the demo</Button>
        <Button href={SITE.github} size="lg" iconBefore="github">GitHub</Button>
      </div>
    </div>
  </section>

  <Section
    id="get-started"
    eyebrow="Get started"
    title="Running in three steps"
    intro="On Linux, or WSL2 on Windows, with Docker. This starts a local instance with the demo wiki of Acme, a fictional IT team."
  >
    <div class="home-split">
      <div>
        <ol class="home-steps">
          <li><strong>Get the release</strong>Clone the tagged release: it holds the Compose file, the nginx configuration and the server scripts.</li>
          <li><strong>Write a minimal <code>.env</code></strong>A local address, a random database password and the image version. The last line lets the demo use a local Git repository: keep it for a throwaway instance.</li>
          <li><strong>Start and load the demo</strong>Then open <code>http://localhost:8000/o/acme/it</code> and sign in with the password the command prints.</li>
        </ol>
        <p class="home-note">
          <strong>For a real server,</strong> skip the demo line, create the first account with
          <code>synaptane admin create</code>, serve it over HTTPS and run <code>synaptane doctor</code>.
          The guide covers the two proxy modes, upgrades and encrypted off-site backups.
        </p>
        <div class="home-links">
          <Button href="/docs/admin/installation/" variant="primary" icon="arrow-right">Install on a server</Button>
          <Button href="/docs/guide/mcp/">Connect an assistant</Button>
        </div>
      </div>
      <div class="home-code">
        <CodeBlock title="Terminal" lang="sh" code={installCode} />
        <p class="home-after">The tidy-up needs an AI provider; the wiki, search, the inbox and MCP work without one.</p>
        <p class="home-after">These commands in detail, and without Docker: <a href="/docs/admin/installation/#demo-data">Demo data</a> in the installation guide.</p>
      </div>
    </div>
  </Section>
</Base>
