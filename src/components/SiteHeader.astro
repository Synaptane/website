---
/**
 * Header of the site pages: logo, main navigation, GitHub, language and theme, and one call to
 * action, "Try it", towards the "Get started" section of the home page. Below 960px (the width
 * the French bar needs on one line) the navigation folds into a <details> menu; the call to
 * action stays in the bar, next to the menu button. The menu works without JavaScript; a small
 * inline script closes it with Escape (focus back on its button) and when the focus leaves it,
 * so that the keyboard never goes on under the veil.
 * The bar spans the whole width, from the page gutters, like the docs header
 * (starlight/Header.astro): the logo and the links stay in place from a site page to the docs.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.svg';
import logoDark from '../assets/brand/logo-dark.svg';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeControl from './ThemeControl.astro';
import { localizePath, stripLangPrefix, useTranslations, type Lang } from '../i18n';
import { SITE, mainNav } from '../site';

interface Props {
  lang: Lang;
  /** URL of this page in the other language. */
  alternateHref: string;
}

const { lang, alternateHref } = Astro.props;
const t = useTranslations(lang);
const current = stripLangPrefix(Astro.url.pathname);
const tryHref = `${localizePath('/', lang)}#get-started`;
const items = mainNav.map((item) => ({
  label: t.nav[item.key],
  href: localizePath(item.path, lang),
  current: current === item.path || current.startsWith(item.path),
}));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizePath('/', lang)} aria-label={t.a11y.home}>
      <Image class="logo logo-light" src={logo} alt="" height={28} loading="eager" />
      <Image class="logo logo-dark" src={logoDark} alt="" height={28} loading="eager" />
    </a>

    <nav class="nav-desktop" aria-label={t.a11y.mainNav}>
      <ul>
        {items.map((i) => <li><a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="tools">
      <a class="icon-link" href={SITE.github} title="GitHub">
        <Icon name="github" size={18} />
        <span class="sr-only">GitHub</span>
      </a>
      <LanguageSwitcher lang={lang} href={alternateHref} />
      <ThemeControl t={t} />
    </div>

    <a class="cta" href={tryHref} title={t.nav.tryItTitle}>{t.nav.tryIt}</a>

    <details class="menu">
      <summary>
        <Icon name="menu" size={18} class="open-icon" />
        <Icon name="x" size={18} class="close-icon" />
        <span>{t.a11y.menu}</span>
      </summary>
      <div class="panel">
        <nav aria-label={t.a11y.mainNav}>
          <ul>
            {items.map((i) => <li><a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a></li>)}
            <li><a href={SITE.github}>GitHub</a></li>
          </ul>
        </nav>
        <div class="panel-tools">
          <LanguageSwitcher lang={lang} href={alternateHref} />
          <ThemeControl t={t} />
        </div>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const menu = document.querySelector('.site-header .menu');
    if (!menu) return;
    const summary = menu.querySelector('summary');
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
    menu.addEventListener('focusout', (e) => {
      if (menu.open && e.relatedTarget && !menu.contains(e.relatedTarget)) menu.open = false;
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  /* The whole width (not the 1120px of the page content), as in the docs. */
  .bar {
    max-width: none;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    border-radius: var(--radius);
  }
  .logo { height: 26px; width: auto; display: block; }
  .logo-dark { display: none; }
  :global(:root[data-theme='dark']) .logo-light { display: none; }
  :global(:root[data-theme='dark']) .logo-dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo-light { display: none; }
    :global(:root:not([data-theme='light'])) .logo-dark { display: block; }
  }

  ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop ul { display: flex; gap: 2px; }
  nav a {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 10px;
    border-radius: var(--radius);
    color: var(--ink-2);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover { background: var(--hover); color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); background: var(--surface); box-shadow: 0 0 0 1px var(--border); }

  .tools { display: flex; align-items: center; gap: var(--space-2); margin-left: auto; }
  .icon-link {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius);
    color: var(--ink-2);
  }
  .icon-link:hover { background: var(--hover); color: var(--ink); }

  /* The call to action: the app's primary button (ink by day, lime by night), at the height of
     the other controls of the bar. */
  .cta {
    display: inline-flex;
    align-items: center;
    flex: none;
    height: 34px;
    padding: 0 14px;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--on-primary);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.15s;
  }
  .cta:hover { background: var(--primary-hover); color: var(--on-primary); text-decoration: none; }

  .menu { display: none; }
  .menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu :global(.close-icon) { display: none; }
  .menu[open] :global(.close-icon) { display: block; }
  .menu[open] :global(.open-icon) { display: none; }
  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-height);
    padding: var(--space-3) var(--gutter) var(--space-5);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 16px 32px rgb(0 0 0 / 0.12);
  }
  /* A veil over the page under the open menu; a tap on it closes the menu (it belongs to the
     summary). Positioned against the header, which is sticky. */
  .menu[open] summary::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-height);
    height: 100vh;
    background: rgb(10 12 15 / 0.32);
    cursor: default;
  }
  /* In Slate the page is nearly black: a denser veil, so that the menu stands out from it. */
  :global(:root[data-theme='dark']) .menu[open] summary::before { background: rgb(0 0 0 / 0.6); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .menu[open] summary::before { background: rgb(0 0 0 / 0.6); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] summary::before { animation: veil-in 0.2s ease-out; }
    @keyframes veil-in { from { opacity: 0; } }
  }
  .panel ul { display: grid; gap: 2px; }
  .panel nav a { display: flex; height: 44px; font-size: 16px; }
  .panel-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 959px) {
    .bar { gap: var(--space-2); }
    .nav-desktop, .tools { display: none; }
    .cta { margin-left: auto; height: 36px; }
    .menu { display: block; }
    /* The page under the open menu does not scroll (as in the docs). */
    :global(html:has(.site-header .menu[open])) { overflow: hidden; }
    /* Touch targets of 40px in the menu (ThemeControl does it by itself below 860px only). */
    .panel-tools :global(.theme-control button) { width: 40px; height: 40px; }
  }
</style>
