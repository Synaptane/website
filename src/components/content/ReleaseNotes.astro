---
/**
 * The release notes, one section per version, from the `releases` collection (the changelog of
 * the main repository, see src/content.config.ts). The notes themselves are in English; the
 * labels around them, and the section headings of Keep a Changelog (Added, Changed…), follow
 * the page language.
 *
 * Each version shows its introduction (the paragraph before its first ### heading, which says
 * what the version brings and how to upgrade); its full notes are folded in a <details>, open
 * for the latest version only. A link to a version or to a heading of its notes (#v1.9.0,
 * #v1.9.0-fixed) opens them (small inline script; without it, the version header and its
 * introduction are still where the link leads). The list of versions stays in view on wide
 * screens; on narrow ones, each version ends with a link back to it.
 *
 * On the French page, the links of the notes to a page that exists in French (the docs, the
 * README…) lead to it: src/content/releases/links.fr.json, written by `npm run sync-docs`.
 */
import { getCollection } from 'astro:content';
import { formatDate, type Lang } from '../../i18n';
import { sectionCounts } from '../../lib/changelog';
import { SITE } from '../../site';
import frLinks from '../../content/releases/links.fr.json';

interface Props {
  lang: Lang;
}

/** Number of versions (newest first) whose full notes are open on load: the latest one. */
const OPEN = 1;

const { lang } = Astro.props;
const labels = {
  en: {
    unreleased: 'Coming soon',
    upcomingPreview: 'Preview coming soon',
    unreleasedTitle: 'Coming changes',
    yanked: 'Withdrawn',
    released: 'Released on',
    release: 'Release on GitHub',
    changelog: 'Changelog on GitHub',
    versions: 'Versions',
    allVersions: 'All versions',
    fullNotes: 'Full notes',
    empty: 'No release notes yet.',
  },
  fr: {
    unreleased: 'À venir',
    upcomingPreview: 'Préversion à venir',
    unreleasedTitle: 'Changements à venir',
    yanked: 'Retirée',
    released: 'Publiée le',
    release: 'La version sur GitHub',
    changelog: 'Le CHANGELOG sur GitHub',
    versions: 'Versions',
    allVersions: 'Toutes les versions',
    fullNotes: 'Notes complètes',
    empty: 'Aucune note de version pour l’instant.',
  },
}[lang];

/** Section headings of Keep a Changelog, in French (the notes below them stay in English). */
const sections: Record<string, string> = {
  Added: 'Ajouté',
  Changed: 'Modifié',
  Deprecated: 'Obsolète',
  Removed: 'Supprimé',
  Fixed: 'Corrigé',
  Security: 'Sécurité',
  Notes: 'Notes',
};
/** The entries of a section, counted: [singular, plural]. */
const entryNames: Record<Lang, Record<string, [string, string]>> = {
  en: {
    Added: ['addition', 'additions'],
    Changed: ['change', 'changes'],
    Deprecated: ['deprecation', 'deprecations'],
    Removed: ['removal', 'removals'],
    Fixed: ['fix', 'fixes'],
    Security: ['security fix', 'security fixes'],
    Notes: ['note', 'notes'],
  },
  fr: {
    Added: ['ajout', 'ajouts'],
    Changed: ['changement', 'changements'],
    Deprecated: ['abandon annoncé', 'abandons annoncés'],
    Removed: ['suppression', 'suppressions'],
    Fixed: ['correction', 'corrections'],
    Security: ['correctif de sécurité', 'correctifs de sécurité'],
    Notes: ['note', 'notes'],
  },
};
const countLabel = ({ heading, count }: { heading: string; count: number }) => {
  const names = entryNames[lang][heading];
  if (!names) return `${heading}${lang === 'fr' ? ' ' : ''}: ${count}`;
  return `${count}${lang === 'fr' ? ' ' : ' '}${count > 1 ? names[1] : names[0]}`;
};

const translateHeadings = (html: string) =>
  lang === 'en'
    ? html
    : html.replace(/<h3([^>]*)>([^<]+)<\/h3>/g, (match, attrs: string, text: string) =>
        sections[text.trim()] ? `<h3${attrs} lang="fr">${sections[text.trim()]}</h3>` : match,
      );

/** French page: the links of the notes to a page that exists in French lead to it. */
const frenchUrls: Record<string, string> = frLinks.links;
const localizeLinks = (html: string) =>
  lang === 'en'
    ? html
    : html.replace(/\bhref="([^"]*)"/g, (match, href: string) => {
        const url = href.replaceAll('&amp;', '&');
        let decoded = url;
        try {
          decoded = decodeURI(url);
        } catch {
          // keep the URL as it is
        }
        const french = frenchUrls[url] ?? frenchUrls[decoded];
        return french ? `href="${french.replaceAll('&', '&amp;').replaceAll('"', '&quot;')}" hreflang="fr"` : match;
      });

const entries = (await getCollection('releases')).sort((a, b) => a.data.position - b.data.position);
const versions = entries.map((entry) => {
  const html = localizeLinks(translateHeadings(entry.rendered?.html ?? ''));
  // The introduction: what comes before the first section heading (### Added…).
  const cut = html.search(/<h3[\s>]/);
  return {
    entry,
    intro: (cut < 0 ? html : html.slice(0, cut)).trim(),
    notes: cut < 0 ? '' : html.slice(cut),
    counts: sectionCounts(entry.body ?? '').map(countLabel).join(' · '),
  };
});
const changelogUrl = `${SITE.github}/blob/main/CHANGELOG.md`;
const title = (version: string) => (version === 'Unreleased' ? labels.unreleasedTitle : `v${version}`);
const shortDate = (date: string) =>
  new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(
    new Date(`${date}T00:00:00Z`),
  );
---

{versions.length === 0 && <p class="muted">{labels.empty}</p>}

<div class:list={['layout', { 'has-toc': versions.length > 1 }]}>
  {
    versions.length > 1 && (
      <nav class="toc" id="versions" aria-labelledby="versions-title">
        <h2 class="toc-title" id="versions-title">{labels.versions}</h2>
        <ul>
          {versions.map(({ entry }) => (
            <li>
              <a href={`#${entry.id}`}>
                <span class="toc-version">{title(entry.data.version)}</span>
                {entry.data.date && <span class="toc-date">{shortDate(entry.data.date)}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="releases">
    {
      versions.map(({ entry, intro, notes, counts }, index) => {
        const { version, date, unreleased, yanked, url } = entry.data;
        // A version without a date has no GitHub release yet: link to the changelog instead.
        const link = !unreleased && url ? { href: url, label: labels.release } : { href: changelogUrl, label: labels.changelog };
        return (
          <section class="release" id={entry.id} aria-labelledby={`${entry.id}-title`}>
            <header>
              <h2 id={`${entry.id}-title`}>
                <a class="anchor" href={`#${entry.id}`}>{title(version)}</a>
              </h2>
              <p class="meta">
                {date ? (
                  <span>
                    {labels.released} <time datetime={date}>{formatDate(new Date(`${date}T00:00:00Z`), lang)}</time>
                  </span>
                ) : (
                  <span class="badge">{/-/.test(version) ? labels.upcomingPreview : labels.unreleased}</span>
                )}
                {yanked && <span class="badge badge-danger">{labels.yanked}</span>}
                <a href={link.href}>{link.label}</a>
              </p>
            </header>
            {intro && <div class="prose notes intro" lang="en" set:html={intro} />}
            {notes && (
              <details class="full" open={index < OPEN}>
                <summary>
                  <span class="summary-label">{labels.fullNotes}</span>
                  {counts && <span class="counts">{counts}</span>}
                </summary>
                <div class="prose notes" lang="en" set:html={notes} />
              </details>
            )}
            {versions.length > 1 && (
              <p class="back">
                <a href="#versions"><span aria-hidden="true">↑</span> {labels.allVersions}</a>
              </p>
            )}
          </section>
        );
      })
    }
  </div>
</div>

<script is:inline>
  // A link to a version or to a heading of its notes (#v1.9.0, #v1.9.0-fixed) opens its notes.
  (() => {
    const openTarget = () => {
      let id = '';
      try {
        id = decodeURIComponent(location.hash.slice(1));
      } catch {
        return;
      }
      const target = id && document.getElementById(id);
      const details = target && target.closest('.release')?.querySelector('details.full');
      if (!details || details.open) return;
      details.open = true;
      if (details.contains(target)) target.scrollIntoView();
    };
    openTarget();
    addEventListener('hashchange', openTarget);
  })();
</script>

<style>
  /* The list of versions: chips above the notes; a column that stays in view on wide screens. */
  .toc { margin: 0 0 var(--space-7); }
  .toc-title {
    margin: 0 0 var(--space-3); font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .toc ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; }
  .toc a {
    display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px;
    border: 1px solid var(--border); border-radius: 999px; background: var(--surface);
    color: var(--ink-2); font-size: 14px; text-decoration: none;
  }
  .toc a:hover { color: var(--ink); background: var(--hover); }
  .toc-date { display: none; }
  .back { margin: var(--space-5) 0 0; font-size: 14px; }
  .back a { color: var(--ink-3); text-decoration: none; }
  .back a:hover { color: var(--accent); text-decoration: underline; }

  @media (min-width: 960px) {
    .layout.has-toc { display: grid; grid-template-columns: minmax(0, 760px) 220px; gap: var(--space-8); justify-content: space-between; }
    .toc {
      grid-column: 2; grid-row: 1; align-self: start; margin: 0;
      position: sticky; top: calc(var(--header-height) + var(--space-5));
      max-height: calc(100vh - var(--header-height) - 2 * var(--space-5)); overflow-y: auto;
      padding-left: var(--space-5); border-left: 1px solid var(--border);
    }
    .toc ul { flex-direction: column; flex-wrap: nowrap; gap: 0; }
    .toc a {
      display: flex; justify-content: space-between; gap: var(--space-3); min-height: 30px; padding: 0 8px;
      margin-left: -8px; border: 0; border-radius: var(--radius); background: none;
    }
    .toc-version { font-variant-numeric: tabular-nums; }
    .toc-date { display: inline; color: var(--ink-3); font-size: 13px; white-space: nowrap; }
    .releases { grid-column: 1; grid-row: 1; }
    /* The list stays in view: no need for a link back to it. */
    .has-toc .back { display: none; }
  }

  .releases { display: grid; gap: var(--space-8); min-width: 0; }
  /* The page sets scroll-padding-top (site.css): no scroll-margin, they would add up. */
  .release { max-width: 760px; }
  .release + .release { padding-top: var(--space-7); border-top: 1px solid var(--border); }
  header { margin-bottom: var(--space-5); padding-bottom: var(--space-4); border-bottom: 1px solid var(--border); }
  h2 { font-size: clamp(26px, 4vw, 34px); margin-bottom: var(--space-2); }
  .anchor { color: inherit; text-decoration: none; }
  .anchor:hover { color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); margin: 0; font-size: 15px; color: var(--ink-3); }
  .badge {
    display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 999px;
    background: var(--warn-bg); color: var(--warn-ink); font-size: 13px; font-weight: 500;
  }
  .badge-danger { background: var(--danger-bg); color: var(--danger); }
  /* Release notes are lists: the interface font, a little smaller than an article. */
  .notes { font-family: var(--font-body); font-size: 16px; line-height: 1.65; max-width: none; }
  .intro { font-size: 17px; color: var(--ink); }
  .intro :global(p:last-child) { margin-bottom: 0; }
  .notes :global(h3) {
    font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--accent); margin: var(--space-6) 0 var(--space-3);
  }
  .notes :global(h3:first-child) { margin-top: 0; }
  .notes :global(h4) { font-size: 17px; margin: var(--space-5) 0 var(--space-2); }
  .notes :global(ul) { padding-left: 20px; }
  .notes :global(li) { margin-bottom: var(--space-2); }
  .notes :global(li::marker) { color: var(--ink-3); }

  /* Full notes, folded. */
  .full { margin-top: var(--space-5); }
  .full summary {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-3);
    padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); cursor: pointer; list-style: none;
  }
  .full summary::-webkit-details-marker { display: none; }
  .full summary::before {
    content: ''; align-self: center; flex: none; width: 7px; height: 7px; margin-right: 2px;
    border-right: 2px solid var(--ink-3); border-bottom: 2px solid var(--ink-3);
    transform: rotate(-45deg); transition: transform 0.15s ease;
  }
  .full[open] summary::before { transform: rotate(45deg); }
  .full summary:hover { background: var(--hover); }
  .summary-label { font-weight: 600; color: var(--ink); }
  .counts { color: var(--ink-3); font-size: 15px; }
  .full[open] summary { margin-bottom: var(--space-5); }
  @media (prefers-reduced-motion: reduce) {
    .full summary::before { transition: none; }
  }
</style>
