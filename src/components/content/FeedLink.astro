---
/** Small link to a feed (RSS), under a page title. */
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<p class="feed">
  <a href={href} type="application/rss+xml">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.2" fill="currentColor" />
    </svg>
    <slot />
  </a>
</p>

<style>
  .feed { margin: var(--space-4) 0 0; font-size: 14px; }
  a { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-3); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
</style>
