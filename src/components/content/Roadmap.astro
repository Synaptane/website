---
/**
 * The roadmap: groups of items, each with a status (no dates). The copy is in the pages
 * (src/pages/roadmap.astro and its French twin); this component only lays it out.
 *
 *   <Roadmap lang="en" groups={[{ id: 'security', title: 'Account security', items: [
 *     { status: 'next', title: 'Two-factor authentication', text: 'TOTP codes…' },
 *   ] }]} />
 */
import type { Lang } from '../../i18n';

export type RoadmapStatus = 'next' | 'later' | 'exploring';
export interface RoadmapItem {
  status: RoadmapStatus;
  title: string;
  /** One or two sentences; simple inline HTML allowed (<code>, <a>). */
  text: string;
}
export interface RoadmapGroup {
  id: string;
  title: string;
  intro?: string;
  items: RoadmapItem[];
}

interface Props {
  lang: Lang;
  groups: RoadmapGroup[];
  /** What each status means, shown above the groups. */
  legend: Record<RoadmapStatus, string>;
}

const { lang, groups, legend } = Astro.props;

const statusLabels: Record<Lang, Record<RoadmapStatus, string>> = {
  en: { next: 'Next', later: 'Later', exploring: 'Exploring' },
  fr: { next: 'Prochainement', later: 'Plus tard', exploring: 'À l’étude' },
};
const labels = statusLabels[lang];
const order: RoadmapStatus[] = ['next', 'later', 'exploring'];
---

<dl class="legend">
  {
    order.map((status) => (
      <div>
        <dt><span class:list={['status', `status-${status}`]}>{labels[status]}</span></dt>
        <dd>{legend[status]}</dd>
      </div>
    ))
  }
</dl>

<div class="roadmap">
  {
    groups.map((group) => (
      <section class="group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="group-head">
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          {group.intro && <p>{group.intro}</p>}
        </div>
        <ul class="items">
          {[...group.items]
            .sort((a, b) => order.indexOf(a.status) - order.indexOf(b.status))
            .map((item) => (
              <li class="item">
                <span class:list={['status', `status-${item.status}`]}>{labels[item.status]}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p set:html={item.text} />
                </div>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .legend {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-7);
  }
  @media (min-width: 720px) {
    .legend { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  }
  .legend div { display: grid; gap: var(--space-2); align-content: start; }
  .legend dt { margin: 0; }
  .legend dd { margin: 0; color: var(--ink-3); font-size: 14.5px; }
  .roadmap { display: grid; gap: var(--space-7); }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    scroll-margin-top: calc(var(--header-height) + 16px);
  }
  @media (min-width: 900px) {
    .group { grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: var(--space-6); }
  }
  .group-head h2 { font-size: 24px; margin-bottom: var(--space-2); }
  .group-head p { color: var(--ink-3); font-size: 15px; margin: 0; }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .item {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
  }
  .item + .item { border-top: 1px solid var(--border); }
  @media (max-width: 559px) {
    .item { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); padding: var(--space-4); }
  }
  h3 { font-size: 16.5px; letter-spacing: -0.01em; margin: 2px 0 var(--space-1); }
  .item p { margin: 0; color: var(--ink-2); font-size: 15px; }
  .status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .status-next { background: var(--accent-soft); color: var(--accent); }
  .status-later { background: var(--bg-2); color: var(--ink-2); border-color: var(--border); }
  .status-exploring { background: transparent; color: var(--ink-3); border: 1px dashed var(--field-border); }
</style>
