---
/** Photo, name and links of the author (About page). The photo is served by the site. */
import Icon from '../Icon.astro';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const role = lang === 'fr' ? 'Auteur et mainteneur de Synaptane' : 'Author and maintainer of Synaptane';
const links = [
  { href: 'https://rene-cotton.fr', label: 'rene-cotton.fr', icon: 'globe' as const },
  { href: 'https://www.linkedin.com/in/cottonrene/', label: 'LinkedIn', icon: 'external' as const },
  { href: 'https://github.com/EtreRe', label: 'GitHub', icon: 'github' as const },
];
---

<div class="author">
  <img src="/images/rene-cotton.jpg" width="128" height="128" alt="René Cotton" loading="eager" decoding="async" />
  <div>
    <p class="name">René Cotton</p>
    <p class="role">{role}</p>
    <ul>
      {links.map((l) => (
        <li><a href={l.href}><Icon name={l.icon} size={15} /> {l.label}</a></li>
      ))}
    </ul>
  </div>
</div>

<style>
  .author { display: flex; flex-direction: column; gap: var(--space-4); }
  img {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg-2);
    box-shadow: 0 0 0 1px var(--border);
  }
  .name { font-family: var(--font-display); font-weight: 600; font-size: 20px; letter-spacing: -0.015em; margin: 0; color: var(--ink); }
  .role { color: var(--ink-3); font-size: 14.5px; margin: 2px 0 var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  a { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); font-size: 15px; text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
  @media (max-width: 719px) {
    .author { flex-direction: row; align-items: center; }
    img { width: 96px; height: 96px; }
  }
</style>
