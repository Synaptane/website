---
/**
 * Link styled as a button (the application's .button). `variant`:
 *   primary   – the one filled action of a screen (ink by day, lime by night)
 *   secondary – bordered, on the surface color
 *   quiet     – text only, accent color
 * Without `href` it renders a <button type="button">.
 *
 *   <Button href="/docs/admin/installation/" variant="primary" icon="arrow-right">Install</Button>
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Props = Omit<HTMLAttributes<'a'>, 'type'> & {
  href?: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  size?: 'md' | 'lg';
  /** Icon after the label (e.g. arrow-right, external). */
  icon?: IconName;
  /** Icon before the label (e.g. github). */
  iconBefore?: IconName;
};

const { href, variant = 'secondary', size = 'md', icon, iconBefore, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['button', `button-${variant}`, `button-${size}`, className]}
  href={href}
  type={href ? undefined : 'button'}
  {...rest}
>
  {iconBefore && <Icon name={iconBefore} size={size === 'lg' ? 18 : 16} />}
  <slot />
  {icon && <Icon name={icon} size={size === 'lg' ? 18 : 16} />}
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-weight: 500;
    font-size: 14.5px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
  }
  .button:hover { background: var(--hover); color: var(--ink); text-decoration: none; }
  .button-lg { height: 46px; padding: 0 20px; font-size: 16px; }
  .button-primary {
    border-color: transparent;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 600;
  }
  .button-primary:hover { background: var(--primary-hover); color: var(--on-primary); }
  .button-quiet { border-color: transparent; background: none; color: var(--accent); padding-inline: 6px; }
  .button-quiet:hover { background: none; color: var(--accent-hover); text-decoration: underline; }
</style>
