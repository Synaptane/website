---
/** Starlight override of the bottom of the mobile menu: site links, GitHub, language, theme. */
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import LanguageSelect from './LanguageSelect.astro';
import SiteLinks from './SiteLinks.astro';
import ThemeSelect from './ThemeSelect.astro';
---

<div class="mobile-footer">
  <SiteLinks />
  <div class="mobile-preferences sl-flex">
    <div class="social-icons"><SocialIcons /></div>
    <LanguageSelect />
    <ThemeSelect />
  </div>
</div>

<style>
  .mobile-footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 0.75rem;
    display: grid;
    gap: 0.75rem;
  }
  .mobile-preferences {
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    column-gap: 1rem;
    padding-block: 0.5rem 1rem;
  }
  .social-icons { display: flex; margin-inline-end: auto; gap: 1rem; align-items: center; }
</style>
