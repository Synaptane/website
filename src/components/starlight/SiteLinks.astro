---
/**
 * The site's main navigation in the docs (Starlight header, its drop-down and the mobile menu):
 * the same links as SiteHeader.astro, in the same order and style, "Docs" marked as the
 * current section.
 */
import { getLang, localizePath, useTranslations } from '../../i18n';
import { mainNav } from '../../site';

interface Props {
  class?: string;
}

const lang = getLang(Astro.locals.starlightRoute.lang);
const t = useTranslations(lang);
---

<nav class:list={['site-links', Astro.props.class]} aria-label={t.a11y.mainNav}>
  <ul>
    {
      mainNav.map((i) => (
        <li>
          <a href={localizePath(i.path, lang)} aria-current={i.key === 'docs' ? 'page' : undefined}>
            {t.nav[i.key]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul { display: flex; flex-wrap: wrap; gap: 2px; list-style: none; margin: 0; padding: 0; }
  a {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 10px;
    border-radius: var(--radius);
    color: var(--ink-2);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover { background: var(--hover); color: var(--ink); }
  a[aria-current='page'] { color: var(--ink); background: var(--surface); box-shadow: 0 0 0 1px var(--border); }
</style>
