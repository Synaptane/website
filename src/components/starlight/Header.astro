---
/**
 * Starlight override of the docs header: Starlight's own header (logo, search, GitHub, theme,
 * language) plus the links back to the site pages (Demo, Roadmap, About), at every width:
 * - below 50rem, in Starlight's mobile menu (MobileMenuFooter.astro);
 * - from 50rem to 64rem, folded into a small "Menu" drop-down (a <details>), as they do not fit
 *   next to the search in French;
 * - from 64rem, as links in the header.
 * The grid styles are Starlight's (components/Header.astro), kept as they are.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import Icon from '../Icon.astro';
import { getLang, useTranslations } from '../../i18n';
import LanguageSelect from './LanguageSelect.astro';
import SiteLinks from './SiteLinks.astro';
import ThemeSelect from './ThemeSelect.astro';

const t = useTranslations(getLang(Astro.locals.starlightRoute.lang));
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="sl-flex print:hidden">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <SiteLinks class="header-site-links" />
    <details class="header-site-menu">
      <summary>
        <Icon name="menu" size={16} />
        <span>{t.a11y.menu}</span>
      </summary>
      <div class="site-menu-panel">
        <SiteLinks />
      </div>
    </details>
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
  </div>
</div>

<script>
  // Close the drop-down on Escape or on a click outside it (the <details> alone stays open).
  const menu = document.querySelector<HTMLDetailsElement>('.header-site-menu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }
  .right-group,
  .social-icons {
    gap: 0.75rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
  /* The site links need room: in the header from 64rem, in a drop-down below. */
  .right-group :global(.header-site-links) { display: none; }
  @media (min-width: 64rem) {
    .right-group :global(.header-site-links) { display: block; }
    .header-site-menu { display: none; }
  }
  @media (max-width: 63.99rem) {
    .right-group { gap: 0.5rem; }
  }
  .header-site-menu { position: relative; }
  .header-site-menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    border-radius: var(--radius);
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }
  .header-site-menu summary::-webkit-details-marker { display: none; }
  .header-site-menu summary:hover,
  .header-site-menu[open] summary { background: var(--hover); color: var(--ink); }
  .site-menu-panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 8px);
    z-index: 10;
    min-width: 12rem;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .site-menu-panel :global(ul) { flex-direction: column; flex-wrap: nowrap; }
  .site-menu-panel :global(a) { display: flex; height: 40px; font-size: 15px; }
  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }
    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }
    .header {
      --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
              var(--sl-content-width)
          ) / 2
      );
      display: grid;
      grid-template-columns:
        minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
        1fr
        auto;
      align-content: center;
    }
  }
</style>
