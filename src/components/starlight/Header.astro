---
/**
 * Starlight override of the docs header, laid out like the header of the site pages
 * (SiteHeader.astro) so that going from one to the other does not move anything: the logo, then
 * the site's navigation (Docs, Demo, Roadmap, About), and on the right GitHub, language, theme
 * and the "Try it" call to action. The docs add their search, just before GitHub.
 * The navigation, at every width:
 * - below 50rem, in Starlight's mobile menu (MobileMenuFooter.astro);
 * - from 50rem to 64rem, folded into a small "Menu" drop-down (a <details>), as it does not fit
 *   next to the search in French;
 * - from 64rem, as links after the logo.
 * The search button shrinks to its magnifier when its room gets too narrow for its label.
 * Height, side margins and logo size match the site's header: starlight.css.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import Icon from '../Icon.astro';
import { getLang, localizePath, useTranslations } from '../../i18n';
import LanguageSelect from './LanguageSelect.astro';
import SiteLinks from './SiteLinks.astro';
import ThemeSelect from './ThemeSelect.astro';

const lang = getLang(Astro.locals.starlightRoute.lang);
const t = useTranslations(lang);
const tryHref = `${localizePath('/', lang)}#get-started`;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden site-nav">
    <SiteLinks class="header-site-links" />
    <details class="header-site-menu">
      <summary>
        <Icon name="menu" size={16} />
        <span>{t.a11y.menu}</span>
      </summary>
      <div class="site-menu-panel">
        <SiteLinks />
      </div>
    </details>
  </div>
  <div class="sl-flex print:hidden search">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
  </div>
  <a class="cta print:hidden" href={tryHref} title={t.nav.tryItTitle}>{t.nav.tryIt}</a>
</div>

<script>
  // Close the drop-down on Escape or on a click outside it (the <details> alone stays open).
  const menu = document.querySelector<HTMLDetailsElement>('.header-site-menu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  /* The site header's rhythm: 24px between the groups, 8px between the tools (8px everywhere
     on narrow screens). */
  .header {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
  }
  .title-wrapper {
    flex: none;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }
  .site-nav { flex: none; align-items: center; }
  .right-group,
  .social-icons {
    flex: none;
    gap: 8px;
    align-items: center;
  }

  /* The search takes the free room and sits at its right end, next to the tools; with less
     than 10rem, the button keeps only its magnifier (its name stays in aria-label). */
  .search {
    flex: 1 1 0;
    min-width: 34px;
    justify-content: flex-end;
    container-type: inline-size;
  }
  .search :global(site-search) { display: contents; }
  @media (min-width: 50rem) {
    .search :global(button[data-open-modal]) { height: 34px; }
    @container (max-width: 10rem) {
      .search :global(button[data-open-modal]) {
        width: 34px;
        padding: 0;
        justify-content: center;
      }
      .search :global(button[data-open-modal] > :not(svg)) { display: none !important; }
    }
  }

  /* GitHub: the site header's icon button. */
  .social-icons :global(a) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    margin: 0;
    border-radius: var(--radius);
  }
  .social-icons :global(a:hover) { background: var(--hover); }

  /* The call to action: the site header's (SiteHeader.astro). */
  .cta {
    display: inline-flex;
    align-items: center;
    flex: none;
    height: 34px;
    padding: 0 14px;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--on-primary);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.15s;
  }
  .cta:hover { background: var(--primary-hover); color: var(--on-primary); text-decoration: none; }

  /* The site links need room: after the logo from 64rem, in a drop-down below. */
  .site-nav :global(.header-site-links) { display: none; }
  @media (min-width: 64rem) {
    .site-nav :global(.header-site-links) { display: block; }
    .header-site-menu { display: none; }
  }
  @media (max-width: 63.99rem) {
    .header { gap: 16px; }
  }
  @media (max-width: 49.99rem) {
    .header { gap: 8px; }
    .cta { height: 36px; }
  }
  .header-site-menu { position: relative; }
  .header-site-menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 10px;
    border-radius: var(--radius);
    color: var(--ink-2);
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }
  .header-site-menu summary::-webkit-details-marker { display: none; }
  .header-site-menu summary:hover,
  .header-site-menu[open] summary { background: var(--hover); color: var(--ink); }
  .site-menu-panel {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + 8px);
    z-index: 10;
    min-width: 12rem;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .site-menu-panel :global(ul) { flex-direction: column; flex-wrap: nowrap; }
  .site-menu-panel :global(a) { display: flex; height: 40px; font-size: 15px; }
</style>
