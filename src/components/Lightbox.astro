---
/**
 * Full-screen viewer for screenshots, included once by the Base layout.
 *
 * Any link marked `data-lightbox="<group>"` opens it instead of the bare image; the links of a
 * group (in page order) become the slides, with previous/next, thumbnails, a counter and the
 * caption. Without JavaScript, the link simply opens the image.
 *
 *   <a href="/full-light.png" data-lightbox="home" data-dark="/full-dark.png"
 *      data-caption="Inbox: notes waiting for the nightly tidy-up."><img src="…" alt="…" /></a>
 *
 * Keys: ← → (or swipe) to move, Home / End, Esc to close (at actual size, Esc first goes back to
 * "fit to the screen"); a click on the image switches between "fit to the screen" and the actual
 * size, to read the details. A vector image (SVG, such as the architecture diagram) fills the
 * screen when fitted, and is shown at twice its size when zoomed.
 */
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang).lightbox;
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<dialog
  class="lightbox"
  aria-label={t.label}
  data-counter={t.counter}
  data-zoom-in={t.zoomIn}
  data-zoom-out={t.zoomOut}
>
  <div class="lb-bar">
    <p class="lb-counter" aria-live="polite"></p>
    <div class="lb-tools">
      <button class="lb-button lb-zoom" type="button" aria-pressed="false" title={t.zoomIn} aria-label={t.zoomIn}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5M11 8v6M8 11h6" /></svg>
      </button>
      <button class="lb-button lb-close" type="button" title={t.close} aria-label={t.close}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div class="lb-stage">
    <button class="lb-nav lb-prev" type="button" title={t.previous} aria-label={t.previous}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <div class="lb-viewport">
      {/* A valid empty image until a slide is shown (a transparent pixel). */}
      <img class="lb-image" src={BLANK} alt="" decoding="async" />
    </div>
    <button class="lb-nav lb-next" type="button" title={t.next} aria-label={t.next}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>

  <div class="lb-foot">
    <p class="lb-caption"></p>
    <ul class="lb-thumbs" aria-label={t.thumbnails}></ul>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');

  if (dialog && typeof dialog.showModal === 'function') {
    const image = dialog.querySelector<HTMLImageElement>('.lb-image')!;
    const viewport = dialog.querySelector<HTMLElement>('.lb-viewport')!;
    const counter = dialog.querySelector<HTMLElement>('.lb-counter')!;
    const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
    const thumbs = dialog.querySelector<HTMLUListElement>('.lb-thumbs')!;
    const zoom = dialog.querySelector<HTMLButtonElement>('.lb-zoom')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;

    type Slide = { light: string; dark?: string; alt: string; caption: string; thumb: string; link: HTMLAnchorElement };
    let slides: Slide[] = [];
    let current = 0;
    let trigger: HTMLElement | null = null;

    const darkTheme = () => {
      const theme = document.documentElement.dataset.theme;
      return theme === 'dark' || (theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
    };
    const source = (slide: Slide) => (darkTheme() && slide.dark ? slide.dark : slide.light);
    /** The image shown in the page for this link (the light or dark one, whichever is visible). */
    const visibleImage = (link: HTMLAnchorElement) =>
      [...link.querySelectorAll('img')].find((img) => img.offsetParent !== null) ?? link.querySelector('img');

    const slideOf = (link: HTMLAnchorElement): Slide => {
      const img = visibleImage(link);
      return {
        light: link.href,
        dark: link.dataset.dark,
        alt: img?.alt ?? '',
        caption: link.dataset.caption ?? img?.alt ?? '',
        thumb: img?.currentSrc || img?.src || link.href,
        link,
      };
    };

    const blank = image.getAttribute('src')!;
    const isVector = (src: string) => /\.svg(?:[?#]|$)/i.test(src);

    const setZoom = (on: boolean) => {
      dialog.classList.toggle('is-zoomed', on);
      // A vector image has no "actual size" worth reading: zoomed, it is shown twice as large.
      image.style.width = on && image.classList.contains('is-vector') && image.naturalWidth ? `${image.naturalWidth * 2}px` : '';
      zoom.setAttribute('aria-pressed', String(on));
      const label = on ? dialog.dataset.zoomOut! : dialog.dataset.zoomIn!;
      zoom.title = label;
      zoom.setAttribute('aria-label', label);
      viewport.scrollTo(0, 0);
    };

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      const slide = slides[current];
      if (!slide) return;
      setZoom(false);
      image.src = source(slide);
      image.classList.toggle('is-vector', isVector(image.src));
      image.alt = slide.alt;
      caption.textContent = slide.caption;
      counter.textContent = dialog.dataset.counter!
        .replace('{n}', String(current + 1))
        .replace('{total}', String(slides.length));
      thumbs.querySelectorAll('button').forEach((button, i) => {
        if (i === current) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
        if (i === current) button.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
      // Preload the neighbours, for an instant previous / next.
      for (const i of [current - 1, current + 1]) {
        const neighbour = slides[(i + slides.length) % slides.length];
        if (neighbour) new Image().src = source(neighbour);
      }
    };

    const open = (link: HTMLAnchorElement) => {
      const group = link.dataset.lightbox!;
      const links = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${CSS.escape(group)}"]`)];
      slides = links.map(slideOf);
      dialog.classList.toggle('is-single', slides.length < 2);
      thumbs.replaceChildren(
        ...slides.map((slide, i) => {
          const item = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'lb-thumb';
          button.setAttribute('aria-label', slide.caption || slide.alt);
          const img = document.createElement('img');
          img.src = slide.thumb;
          img.alt = '';
          img.loading = 'lazy';
          button.append(img);
          button.addEventListener('click', () => show(i));
          item.append(button);
          return item;
        }),
      );
      trigger = link;
      document.documentElement.classList.add('lightbox-open');
      dialog.showModal();
      show(links.indexOf(link));
      dialog.querySelector<HTMLButtonElement>('.lb-close')!.focus();
    };

    document.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      open(link);
    });

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    zoom.addEventListener('click', () => setZoom(!dialog.classList.contains('is-zoomed')));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    image.addEventListener('click', () => setZoom(!dialog.classList.contains('is-zoomed')));

    // A click on the dark area around the image closes the viewer.
    dialog.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target === dialog || target.classList.contains('lb-stage') || target.classList.contains('lb-viewport')) {
        if (!dialog.classList.contains('is-zoomed')) dialog.close();
      }
    });

    // Esc at actual size goes back to "fit to the screen"; a second Esc closes the viewer.
    let unzoomedByEscape = false;
    dialog.addEventListener('cancel', (event) => {
      if (unzoomedByEscape || dialog.classList.contains('is-zoomed')) {
        event.preventDefault();
        if (dialog.classList.contains('is-zoomed')) setZoom(false);
      }
      unzoomedByEscape = false;
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dialog.classList.contains('is-zoomed')) {
        event.preventDefault();
        setZoom(false);
        unzoomedByEscape = true; // in case the browser still sends "cancel" for this key
        return;
      }
      unzoomedByEscape = false;
      if (event.key === 'ArrowLeft') show(current - 1);
      else if (event.key === 'ArrowRight') show(current + 1);
      else if (event.key === 'Home') show(0);
      else if (event.key === 'End') show(slides.length - 1);
      else return;
      event.preventDefault();
    });

    // Swipe left or right (touch), when the image is fitted to the screen.
    let startX = 0;
    let startY = 0;
    viewport.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
      startY = event.clientY;
    });
    viewport.addEventListener('pointerup', (event) => {
      if (event.pointerType !== 'touch' || dialog.classList.contains('is-zoomed')) return;
      const dx = event.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(event.clientY - startY) * 1.5) show(current + (dx < 0 ? 1 : -1));
    });

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      image.src = blank;
      image.classList.remove('is-vector');
      setZoom(false);
      trigger?.focus();
      trigger = null;
    });
  }
</script>

<style is:global>
  html.lightbox-open { overflow: hidden; }

  /* Always dark, whatever the site theme: the screenshots stand out on it. */
  dialog.lightbox {
    --lb-ink: #e6eaf0;
    --lb-ink-2: #a7b0bd;
    --lb-line: rgb(255 255 255 / 0.12);
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 12 15);
    color: var(--lb-ink);
    overflow: hidden;
    display: none;
    grid-template-rows: auto minmax(0, 1fr) auto;
    /* One column, as wide as the screen: the thumbnail strip scrolls instead of widening it. */
    grid-template-columns: minmax(0, 1fr);
  }
  dialog.lightbox[open] { display: grid; animation: lb-in 0.18s ease-out; }
  dialog.lightbox::backdrop { background: transparent; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }

  .lb-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
  }
  .lb-counter { margin: 0; font-size: 14px; color: var(--lb-ink-2); font-variant-numeric: tabular-nums; }
  .lb-tools { display: flex; gap: var(--space-2); }

  .lb-button, .lb-nav {
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--lb-line);
    background: rgb(255 255 255 / 0.06);
    color: var(--lb-ink);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .lb-button { width: 40px; height: 40px; border-radius: var(--radius); }
  .lb-button:hover, .lb-nav:hover { background: rgb(255 255 255 / 0.14); border-color: rgb(255 255 255 / 0.24); }
  .lb-button:focus-visible, .lb-nav:focus-visible, .lb-thumb:focus-visible {
    outline: 2px solid var(--accent, #b6f36a);
    outline-offset: 2px;
  }
  .lb-button svg, .lb-nav svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lb-zoom[aria-pressed='true'] { background: rgb(255 255 255 / 0.18); }

  .lb-stage {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    min-height: 0;
  }
  .lb-nav { width: 48px; height: 48px; border-radius: 999px; }
  .is-single .lb-nav, .is-single .lb-thumbs { display: none; }

  .lb-viewport {
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: grid;
    /* Tracks bounded by the viewport: otherwise they grow to the image's natural width. */
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    overflow: hidden;
    touch-action: pan-y;
  }
  .lb-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.7);
    cursor: zoom-in;
    user-select: none;
  }
  /* A vector image fills the space when fitted (it scales without blur). */
  .lb-image.is-vector { width: 100%; height: 100%; box-shadow: none; border-radius: 0; }
  /* Actual size: the viewport scrolls to explore the details. */
  .is-zoomed .lb-viewport { grid-template: auto / auto; overflow: auto; place-items: start; touch-action: auto; }
  .is-zoomed .lb-image { max-width: none; max-height: none; cursor: zoom-out; border-radius: 0; }
  .is-zoomed .lb-image.is-vector { height: auto; }

  .lb-foot { padding: var(--space-3) var(--space-4) var(--space-4); }
  .lb-caption {
    max-width: 80ch;
    min-height: 1.5em;
    margin: 0 auto var(--space-3);
    text-align: center;
    font-size: 15px;
    line-height: 1.5;
    color: var(--lb-ink);
  }
  .lb-thumbs {
    list-style: none;
    max-width: 100%;
    margin: 0 auto;
    padding: 2px;
    display: flex;
    justify-content: safe center;
    gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .lb-thumb {
    display: block;
    width: 96px;
    padding: 0;
    border: 1px solid var(--lb-line);
    border-radius: 6px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .lb-thumb img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .lb-thumb:hover { opacity: 0.85; }
  .lb-thumb[aria-current='true'] { opacity: 1; border-color: var(--lb-ink); }

  @media (max-width: 640px) {
    .lb-stage { grid-template-columns: minmax(0, 1fr); padding: 0 var(--space-2); }
    /* On phones: the arrows float over the image, swiping does the rest. */
    .lb-nav { position: absolute; top: 50%; translate: 0 -50%; z-index: 1; width: 40px; height: 40px; background: rgb(10 12 15 / 0.6); }
    .lb-prev { left: var(--space-2); }
    .lb-next { right: var(--space-2); }
    .lb-thumb { width: 64px; }
    .lb-caption { font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog.lightbox[open] { animation: none; }
    .lb-button, .lb-nav, .lb-thumb { transition: none; }
  }
</style>
