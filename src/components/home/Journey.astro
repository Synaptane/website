  .is-active .scene-2 .line-del { animation: j-strike 0.5s ease 2.2s both; }
  .is-active .scene-2 .line-del del { animation: j-strike 0.5s ease 2.2s both; }
  .is-active .scene-2 .line-del .sign { animation: j-fade 0.3s 2.2s both; }
  .is-active .scene-2 .line-add { animation: j-slide 0.6s var(--ease) 3s both; }
  .is-active .scene-2 .a-commit { animation: j-in 0.5s var(--ease) 6.3s both; }
  .is-active .scene-2 .a-pushed { animation: j-fade 0.4s 7.2s both; }
  .is-active .scene-2 .a-summary { animation: j-fade 0.4s 6.3s both; }
