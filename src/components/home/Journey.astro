  .is-animated .scene {
    grid-area: stage;
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
    pointer-events: none;
  }
  .is-animated .is-active .scene { opacity: 1; transform: none; z-index: 1; }

  .is-animated .step-text {
