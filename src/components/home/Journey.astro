  .is-animated .is-active .step-text {
    background: var(--bg);
    box-shadow: 0 0 0 1px var(--border);
  }
  .is-animated .step-progress {
    display: block;
    position: absolute;
    left: 9px;
    top: 16px;
    bottom: 16px;
    width: 2px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .step-progress-fill { display: block; width: 100%; height: 0; background: var(--accent); }
  .is-animated .is-active .step-progress-fill { animation: journey-progress var(--dur) linear forwards; }
  @keyframes journey-progress { to { height: 100%; } }
  .step-jump {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    border-radius: var(--radius-lg);
    background: none;
    padding: 0;
  }
  .step-jump[hidden] { display: none; }
  .step-jump:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .is-animated .controls { display: flex; grid-area: ctrl; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .dots { display: flex; gap: 6px; }
  .dot-jump {
    position: relative;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: none;
