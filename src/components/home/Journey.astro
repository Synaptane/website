  .is-paused :global(*), .is-paused :global(*::before), .is-paused :global(*::after) { animation-play-state: paused !important; }

  /* The choreography of each scene: initial states come from the `from` keyframes, the
     final state is the static one. Delays in seconds from the start of the step. */
  @keyframes j-in { from { opacity: 0; transform: translateY(10px); } }
  @keyframes j-pop { from { opacity: 0; transform: translateY(8px) scale(0.97); } }
  @keyframes j-fade { from { opacity: 0; } }
  @keyframes j-out { to { opacity: 0; } }
  @keyframes j-show { from { opacity: 1; } to { opacity: 1; } }
