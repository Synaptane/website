  /* ---------- Animated mode (JavaScript, motion allowed) ---------- */
  /* Phones and tablets: the active step's text, the stage, then dots and the pause button.
     The three texts share one cell (the tallest sets its height): the inactive ones are
     transparent but still read by screen readers. */
  .journey.is-animated {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'text' 'stage' 'ctrl';
    gap: var(--space-3);
  }
  .is-animated .steps, .is-animated .step { display: contents; }
  .is-animated .step-text { grid-area: text; }
