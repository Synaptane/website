---
/**
 * The journey of a note, in three steps: saved from a conversation (MCP), filed during the
 * night (tidy-up, Git commit), found the next morning by a colleague's assistant.
 *
 * Accessible first: every step is real text (an ordered list), and every scene is real HTML,
 * readable by screen readers and search engines. Without JavaScript, or with
 * `prefers-reduced-motion: reduce`, the three scenes are shown side by side in their final
 * state. Otherwise a small inline script turns the list into a stage: one scene at a time,
 * with a progress bar per step, a pause button and clickable steps. The timing is in CSS: the
 * end of a step's progress bar animation moves to the next step, so pausing (the
 * `is-paused` class) pauses everything at once. The animation also pauses when the section is
 * off screen.
 *
 * The fictional content comes from the demo data set (examples/acme-wiki of the main
 * repository): the note "NAS capacity raised to 16 TB", filed into infra/storage.md.
 */
import HomeIcon from './HomeIcon.astro';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = ({
  en: {
    label: 'The journey of a note',
    pause: 'Pause',
    play: 'Play',
    show: 'Show this step: ',
    reply: 'Reply to Claude…',
    steps: [
      {
        when: 'Tuesday, 4:10 PM',
        title: 'Saved from the conversation',
        text: 'Hugo tells Claude the NAS now has 16 TB and asks it to save that for the team. Claude drops a note into the IT space’s inbox, over MCP.',
      },
      {
        when: 'That night, 2:00 AM',
        title: 'Filed overnight',
        text: 'The tidy-up agent reads the inbox, finds the existing Storage page and updates it instead of creating a duplicate. One commit, pushed to your Git repository.',
      },
      {
        when: 'Wednesday, 9:15 AM',
        title: 'Found the next morning',
        text: 'Inès asks her own assistant about the NAS. It searches Synaptane and answers from the Storage page, with a link to it.',
      },
    ],
    s1: {
      who: 'Hugo · Claude',
      mcp: 'Synaptane',
      user: 'We put four more disks in the NAS: 16 TB usable now, still RAID 6. Save this for the team.',
      tool: 'inbox_add',
      toolArg: 'acme/it',
      noteLabel: 'Note in the inbox',
      noteTitle: 'NAS capacity raised to 16 TB',
      noteHint: 'Suggested place:',
      ai: ['Saved in the inbox of ', 'acme/it', '. It will be filed tonight; a page already covers this: ', 'Storage', '.'],
    },
    s2: {
      who: 'Nightly tidy-up · acme/it',
      time: '02:00',
      inbox: 'Inbox',
      items: ['NAS capacity raised to 16 TB', 'VM backups', 'No deployments on Friday afternoons'],
      pending: 'reading…',
      filed: 'filed',
      heading: '# Storage',
      del: 'The NAS in rack B provides 8 TB of usable space in RAID 6.',
      add: 'The NAS in rack B provides 16 TB of usable space in RAID 6, since four disks were added on 1 October 2026.',
      ctx: 'It receives the vzdump backups and hosts the team’s file shares. Shares are mounted from nas.acme.internal.',
      ctx2: 'A replacement by distributed storage is being studied: see the [Ceph project](../projects/ceph.md).',
      summary: '3 filed, 0 left',
      commit: 'Tidy-up: 3 item(s) filed',
      author: 'Synaptane tidy-up',
      pushed: 'pushed to origin/main',
    },
    s3: {
      who: 'Inès · Claude',
      mcp: 'Synaptane',
      user: 'How much usable space does the NAS have?',
      tool: 'search',
      toolArg: '"NAS"',
      resultTitle: 'Storage',
      excerpt: ['The NAS in rack B provides ', '16 TB', ' of usable space in RAID 6…'],
      ai: 'The NAS has 16 TB of usable space, in RAID 6, since four disks were added on 1 October 2026.',
      source: 'Source:',
    },
  },
  fr: {
    label: 'Le parcours d’une note',
    pause: 'Pause',
    play: 'Lecture',
    show: 'Afficher cette étape : ',
    reply: 'Répondre à Claude…',
    steps: [
      {
        when: 'Mardi, 16 h 10',
        title: 'Déposée depuis la conversation',
        text: 'Hugo annonce à Claude que le NAS passe à 16 To et lui demande de le garder pour l’équipe. Claude dépose une note dans l’inbox de l’espace IT, par MCP.',
      },
      {
        when: 'La nuit suivante, 2 h',
        title: 'Rangée pendant la nuit',
        text: 'L’agent de rangement lit l’inbox, retrouve la page Stockage et la met à jour plutôt que d’en créer une seconde. Un commit, poussé dans votre dépôt Git.',
      },
      {
        when: 'Mercredi, 9 h 15',
        title: 'Retrouvée le lendemain',
        text: 'Inès interroge son propre assistant sur le NAS. Il cherche dans Synaptane et répond d’après la page Stockage, lien à l’appui.',
      },
    ],
    s1: {
      who: 'Hugo · Claude',
      mcp: 'Synaptane',
      user: 'On a ajouté quatre disques au NAS : 16 To utiles maintenant, toujours en RAID 6. Garde ça pour l’équipe.',
      tool: 'inbox_add',
      toolArg: 'acme/it',
      noteLabel: 'Note dans l’inbox',
      noteTitle: 'Capacité du NAS portée à 16 To',
      noteHint: 'Emplacement suggéré :',
      ai: ['C’est noté dans l’inbox de ', 'acme/it', '. Ce sera rangé cette nuit ; une page traite déjà du sujet : ', 'Stockage', '.'],
    },
    s2: {
      who: 'Rangement nocturne · acme/it',
      time: '02:00',
      inbox: 'Inbox',
      items: ['Capacité du NAS portée à 16 To', 'Sauvegardes des VM', 'Pas de mise en production le vendredi'],
      pending: 'lecture…',
      filed: 'rangée',
      heading: '# Stockage',
      del: 'Le NAS de la baie B offre 8 To utiles en RAID 6.',
      add: 'Le NAS de la baie B offre 16 To utiles en RAID 6, depuis l’ajout de quatre disques le 1er octobre 2026.',
      ctx: 'Il reçoit les sauvegardes vzdump et héberge les partages de fichiers de l’équipe. Les partages sont montés depuis nas.acme.internal.',
      ctx2: 'Un remplacement par un stockage distribué est à l’étude : voir le [projet Ceph](../projects/ceph.md).',
      summary: '3 rangées, 0 restante',
      commit: 'Tidy-up: 3 item(s) filed',
      author: 'Synaptane tidy-up',
      pushed: 'poussé sur origin/main',
    },
    s3: {
      who: 'Inès · Claude',
      mcp: 'Synaptane',
      user: 'Combien d’espace utile a le NAS ?',
      tool: 'search',
      toolArg: '"NAS"',
      resultTitle: 'Stockage',
      excerpt: ['Le NAS de la baie B offre ', '16 To', ' utiles en RAID 6…'],
      ai: 'Le NAS offre 16 To utiles, en RAID 6, depuis l’ajout de quatre disques le 1er octobre 2026.',
      source: 'Source :',
    },
  },
} as const)[lang];

const { s1, s2, s3 } = copy;
const path = 'infra/storage.md';
/** Duration of each step in the animation, in seconds (read by the CSS). */
const durations = [8, 9.5, 8] as const;
---

<div class="journey" data-journey aria-label={copy.label} role="group">
  <ol class="steps">
    {/* Step 1: the conversation. */}
    <li class="step" data-journey-step style={`--dur: ${durations[0]}s`}>
      <div class="step-text">
        <span class="step-progress" aria-hidden="true"><span class="step-progress-fill"></span></span>
        <p class="step-when"><span class="step-num" aria-hidden="true">1</span>{copy.steps[0].when}</p>
        <h3 class="step-title">{copy.steps[0].title}</h3>
        <p class="step-desc">{copy.steps[0].text}</p>
        <button type="button" class="step-jump" data-journey-jump="0" hidden><span class="sr-only">{copy.show}{copy.steps[0].title}</span></button>
      </div>
      <div class="scene scene-chat scene-1">
        <div class="bar">
          <span class="bar-who"><HomeIcon name="chat" size={15} />{s1.who}</span>
          <span class="bar-mcp"><span class="dot" aria-hidden="true"></span>MCP · {s1.mcp}</span>
        </div>
        <div class="body">
          <p class="msg msg-user a-user">{s1.user}</p>
          <p class="tool a-tool">
            <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M23 9.5C21.6 6.6 9 6.2 9 11.6c0 2.2 1.3 3.1 3 3.6"/><path d="M20 16.8c1.7.5 3 1.4 3 3.6 0 5.4-12.6 5-14 2.1"/></g><g fill="currentColor"><circle cx="23" cy="9.5" r="2.6"/><circle cx="9" cy="22.5" r="2.6"/></g><circle cx="16" cy="16" r="2.2" class="mark-dot"/></svg>
            <code>{s1.tool}</code><span class="tool-arg">{s1.toolArg}</span>
            <span class="tool-state" aria-hidden="true"><span class="spin a-wait"></span><span class="ok a-done"><HomeIcon name="check" size={14} /></span></span>
          </p>
          <div class="note a-note">
            <span class="note-label"><HomeIcon name="inbox" size={13} />{s1.noteLabel}</span>
            <strong class="note-title">{s1.noteTitle}</strong>
            <span class="note-hint">{s1.noteHint} <code>{path}</code></span>
          </div>
          <p class="msg msg-ai a-ai">{s1.ai[0]}<code>{s1.ai[1]}</code>{s1.ai[2]}<span class="link">{s1.ai[3]}</span>{s1.ai[4]}</p>
          <div class="composer" aria-hidden="true"><span>{copy.reply}</span><span class="send"><HomeIcon name="arrow-up" size={14} /></span></div>
        </div>
      </div>
    </li>

    {/* Step 2: the nightly tidy-up. */}
    <li class="step" data-journey-step style={`--dur: ${durations[1]}s`}>
      <div class="step-text">
        <span class="step-progress" aria-hidden="true"><span class="step-progress-fill"></span></span>
        <p class="step-when"><span class="step-num" aria-hidden="true">2</span>{copy.steps[1].when}</p>
        <h3 class="step-title">{copy.steps[1].title}</h3>
        <p class="step-desc">{copy.steps[1].text}</p>
        <button type="button" class="step-jump" data-journey-jump="1" hidden><span class="sr-only">{copy.show}{copy.steps[1].title}</span></button>
      </div>
      <div class="scene scene-tidy scene-2">
        <div class="bar">
          <span class="bar-who"><HomeIcon name="moon" size={15} />{s2.who}</span>
          <span class="bar-time">{s2.time}</span>
        </div>
        <div class="body tidy">
          <div class="inbox">
            <p class="inbox-head"><HomeIcon name="inbox" size={14} />{s2.inbox}</p>
            <ul>
              <li class="item item-main">
                <span class="item-title">{s2.items[0]}</span>
                <span class="item-state">
                  <span class="a-reading">{s2.pending}</span>
                  <span class="a-filed"><HomeIcon name="check" size={13} />{s2.filed}</span>
                </span>
              </li>
              <li class="item item-2">
                <span class="item-title">{s2.items[1]}</span>
                <span class="item-state"><span class="a-filed"><HomeIcon name="check" size={13} />{s2.filed}</span></span>
              </li>
              <li class="item item-3">
                <span class="item-title">{s2.items[2]}</span>
                <span class="item-state"><span class="a-filed"><HomeIcon name="check" size={13} />{s2.filed}</span></span>
              </li>
            </ul>
            <p class="inbox-foot a-summary">{s2.summary}</p>
          </div>
          <div class="file">
            <p class="file-head"><HomeIcon name="file" size={14} /><code>content/{path}</code></p>
            <div class="diff">
              <p class="line line-ctx"><span class="sign" aria-hidden="true"> </span><span>{s2.heading}</span></p>
              <p class="line line-del"><span class="sign">-</span><del>{s2.del}</del></p>
              <p class="line line-add"><span class="sign">+</span><ins>{s2.add}</ins></p>
              <p class="line line-ctx"><span class="sign" aria-hidden="true"> </span><span>{s2.ctx}</span></p>
              <p class="line line-ctx line-extra"><span class="sign" aria-hidden="true"> </span><span>{s2.ctx2}</span></p>
            </div>
          </div>
          <p class="commit a-commit">
            <span class="commit-icon"><HomeIcon name="commit" size={16} /></span>
            <code class="hash">4e1b7c2</code>
            <span class="commit-msg">{s2.commit}</span>
            <span class="commit-meta">{s2.author} · <span class="a-pushed"><HomeIcon name="check" size={12} />{s2.pushed}</span></span>
          </p>
        </div>
      </div>
    </li>

    {/* Step 3: the answer, the next morning. */}
    <li class="step" data-journey-step style={`--dur: ${durations[2]}s`}>
      <div class="step-text">
        <span class="step-progress" aria-hidden="true"><span class="step-progress-fill"></span></span>
        <p class="step-when"><span class="step-num" aria-hidden="true">3</span>{copy.steps[2].when}</p>
        <h3 class="step-title">{copy.steps[2].title}</h3>
        <p class="step-desc">{copy.steps[2].text}</p>
        <button type="button" class="step-jump" data-journey-jump="2" hidden><span class="sr-only">{copy.show}{copy.steps[2].title}</span></button>
      </div>
      <div class="scene scene-chat scene-3">
        <div class="bar">
          <span class="bar-who"><HomeIcon name="chat" size={15} />{s3.who}</span>
          <span class="bar-mcp"><span class="dot" aria-hidden="true"></span>MCP · {s3.mcp}</span>
        </div>
        <div class="body">
          <p class="msg msg-user a-user">{s3.user}</p>
          <p class="tool a-tool">
            <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M23 9.5C21.6 6.6 9 6.2 9 11.6c0 2.2 1.3 3.1 3 3.6"/><path d="M20 16.8c1.7.5 3 1.4 3 3.6 0 5.4-12.6 5-14 2.1"/></g><g fill="currentColor"><circle cx="23" cy="9.5" r="2.6"/><circle cx="9" cy="22.5" r="2.6"/></g><circle cx="16" cy="16" r="2.2" class="mark-dot"/></svg>
            <code>{s3.tool}</code><span class="tool-arg">{s3.toolArg}</span>
            <span class="tool-state" aria-hidden="true"><span class="spin a-wait"></span><span class="ok a-done"><HomeIcon name="check" size={14} /></span></span>
          </p>
          <div class="result a-result">
            <span class="result-title"><HomeIcon name="file" size={13} />{s3.resultTitle}</span>
            <code class="result-path">acme/it/{path}</code>
            <span class="result-excerpt">{s3.excerpt[0]}<mark>{s3.excerpt[1]}</mark>{s3.excerpt[2]}</span>
          </div>
          <p class="msg msg-ai a-ai">{s3.ai}</p>
          <p class="source a-source">{s3.source} <span class="link">{s3.resultTitle}</span> <code>{path}</code></p>
          <div class="composer" aria-hidden="true"><span>{copy.reply}</span><span class="send"><HomeIcon name="arrow-up" size={14} /></span></div>
        </div>
      </div>
    </li>
  </ol>

  <div class="controls">
    <div class="dots">
      {
        copy.steps.map((step, i) => (
          <button type="button" class="dot-jump" data-journey-jump={i} hidden>
            <span class="sr-only">{copy.show}{step.title}</span>
          </button>
        ))
      }
    </div>
    <button type="button" class="toggle" data-journey-toggle hidden>
      <span class="icon-pause"><HomeIcon name="pause" size={14} /></span>
      <span class="icon-play"><HomeIcon name="play" size={14} /></span>
      <span class="toggle-pause">{copy.pause}</span>
      <span class="toggle-play">{copy.play}</span>
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-journey]:not([data-bound])');
    if (!root) return;
    root.dataset.bound = '';
    const steps = [...root.querySelectorAll('[data-journey-step]')];
    const jumps = [...root.querySelectorAll('[data-journey-jump]')];
    const toggle = root.querySelector('[data-journey-toggle]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let userPaused = false;
    let visible = false;
    let seen = false;

    const show = (index) => {
      current = (index + steps.length) % steps.length;
      steps.forEach((step) => step.classList.remove('is-active'));
      jumps.forEach((j) => j.setAttribute('aria-current', j.dataset.journeyJump === String(current) ? 'step' : 'false'));
      void root.offsetWidth; // restart the CSS animations of the scene
      steps[current].classList.add('is-active');
    };
    const sync = () => {
      root.classList.toggle('is-paused', userPaused || !visible);
      root.classList.toggle('is-user-paused', userPaused);
    };
    const setMode = () => {
      const animated = !reduce.matches && 'IntersectionObserver' in window;
      root.classList.toggle('is-animated', animated);
      toggle.hidden = !animated;
      jumps.forEach((j) => (j.hidden = !animated));
      if (animated) show(current);
      else steps.forEach((s) => s.classList.remove('is-active'));
    };

    root.addEventListener('animationend', (e) => {
      if (e.target.classList.contains('step-progress-fill') && e.target.closest('.is-active')) show(current + 1);
    });
    jumps.forEach((jump) =>
      jump.addEventListener('click', () => {
        userPaused = false; // a step chosen by hand plays from its start
        sync();
        show(Number(jump.dataset.journeyJump));
      }),
    );
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      sync();
    });
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !seen) {
          seen = true;
          if (root.classList.contains('is-animated')) show(0);
        }
        sync();
      },
      { threshold: 0.35 },
    ).observe(root);
    reduce.addEventListener('change', setMode);
    setMode();
    sync();
  })();
</script>

<style>
  /* ---------- Layout: static (no JavaScript, reduced motion) ---------- */
  .journey { --ease: cubic-bezier(0.2, 0.7, 0.2, 1); position: relative; }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 960px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .step { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .step-text { position: relative; }
  .step-when {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-2);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
  }
  .step-num {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 12.5px;
    font-weight: 600;
  }
  .step-title { font-size: 19px; margin: 0 0 var(--space-2); }
  .step-desc { margin: 0; color: var(--ink-2); font-size: 15.5px; line-height: 1.55; }
  .step-progress { display: none; }
  .controls { display: none; }

  /* ---------- Scenes ---------- */
  .scene {
    container-type: inline-size;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px -12px rgb(0 0 0 / 0.12);
    overflow: hidden;
    font-size: 14px;
    line-height: 1.5;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 40px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .bar-who { display: inline-flex; align-items: center; gap: 7px; font-weight: 500; color: var(--ink-2); min-width: 0; }
  .bar-mcp, .bar-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
    font-size: 12px;
  }
  .bar-time { font-family: var(--font-mono); }
  .dot { width: 7px; height: 7px; border-radius: 999px; background: var(--ok); }
  .scene { display: flex; flex-direction: column; flex: 1; }
  .body { display: flex; flex-direction: column; gap: 12px; padding: 16px; flex: 1; }
  .scene-chat .body { justify-content: flex-end; }
  .composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
    padding: 7px 8px 7px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-3);
    font-size: 13px;
  }
  .send {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--ink-3);
  }
  .scene code { font-family: var(--font-mono); font-size: 0.9em; }
  .msg { margin: 0; max-width: 92%; }
  .msg-user {
    align-self: flex-end;
    padding: 9px 13px;
    border-radius: 14px 14px 4px 14px;
    background: var(--accent-soft);
    color: var(--ink);
  }
  .msg-ai { color: var(--ink); }
  .msg-ai code { padding: 1px 5px; border-radius: 5px; background: var(--bg-2); }
  .link { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .tool {
    display: flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin: 0;
    padding: 5px 10px 5px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .mark { width: 16px; height: 16px; color: var(--ink); }
  .mark-dot { fill: var(--accent); }
  .tool code { color: var(--ink); font-weight: 500; }
  .tool-arg { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-3); }
  .tool-state { display: grid; width: 14px; height: 14px; }
  .tool-state > * { grid-area: 1 / 1; }
  .spin {
    width: 12px;
    height: 12px;
    margin: 1px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 999px;
    opacity: 0;
  }
  .ok { display: inline-flex; color: var(--ok); }
  .note, .result {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .note-label, .result-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--ink-3);
  }
