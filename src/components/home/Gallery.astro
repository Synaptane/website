---
/**
 * Screenshots of the application (demo data set), with a caption each, in the page's language
 * and the site's theme. Each frame shows the useful part of a screen, large enough to read; a
 * click opens the whole window in the Lightbox viewer. Three columns from 800 px; below, one row
 * that scrolls sideways (one screenshot at a time, the next one peeking out).
 *
 * The images are taken on the static demo by `scripts/build-demo/browse.py --gallery`
 * (src/assets/app/, see src/lib/screenshots.ts): add a screen there to show it here.
 */
import { getLang } from '../../i18n';
import { shot } from '../../lib/screenshots';
import Screenshot from '../Screenshot.astro';

export type ShotName = 'search' | 'ocr' | 'health';

interface Props {
  items: { shot: ShotName; title: string; text: string; alt: string }[];
  /** Accessible suffix of the links to the full-size images. */
  openLabel: string;
  /** Lightbox group: the gallery's screenshots and any other link of the same group. */
  group?: string;
}

const { items, openLabel, group = 'home' } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<ul class="gallery">
  {
    items.map((item) => {
      const crop = shot(item.shot, lang, 'crop');
      const window = shot(item.shot, lang);
      return (
        <li>
          <Screenshot
            class="gallery-shot"
            light={crop.light}
            dark={crop.dark}
            full={window.light}
            fullDark={window.dark}
            alt={item.alt}
            sizes="(min-width: 1184px) 358px, (min-width: 800px) calc(33vw - 28px), min(82vw, 420px)"
            zoom={group}
            zoomCaption={`${item.title} ${item.text}`}
            zoomLabel={openLabel}
          >
            <Fragment slot="caption">
              <strong>{item.title}</strong> {item.text}
            </Fragment>
          </Screenshot>
        </li>
      );
    })
  }
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  /* Phones and small tablets: one row, scrolled sideways, edge to edge. */
  @media (max-width: 799px) {
    .gallery {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(82%, 420px);
      gap: var(--space-4);
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter) var(--space-4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: thin;
    }
    li { scroll-snap-align: start; }
  }
  li { min-width: 0; }
  .gallery :global(.gallery-shot .frame) {
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 10px 28px -14px rgb(0 0 0 / 0.18);
  }
  .gallery :global(.gallery-shot figcaption) {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
    text-align: left;
  }
  .gallery :global(.gallery-shot figcaption strong) { color: var(--ink); font-weight: 600; }
</style>
