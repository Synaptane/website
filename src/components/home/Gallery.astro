---
/**
 * Screenshots of the application (demo data set, light theme), with a caption each. Images are
 * optimized by Astro; each one links to the full-size original, opened in the Lightbox viewer.
 * Two sources:
 * - most files in src/assets/app/ are copies of docs/assets/screenshot-*.png of the main
 *   repository (also synced into public/docs/assets/): copy them again when they change;
 * - pdf, office and ocr are taken on the static demo by `scripts/build-demo/browse.py
 *   --gallery`, which also writes their originals to public/images/app/.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import search from '../../assets/app/search.png';
import inbox from '../../assets/app/inbox.png';
import health from '../../assets/app/health.png';
import history from '../../assets/app/history.png';
import assistants from '../../assets/app/assistants.png';
import routines from '../../assets/app/routines.png';
import pdf from '../../assets/app/pdf.png';
import office from '../../assets/app/office.png';
import ocr from '../../assets/app/ocr.png';

const docs = (name: string) => `/docs/assets/screenshot-${name}.png`;
const demo = (name: string) => `/images/app/screenshot-${name}.png`;
/** Each screenshot: the image Astro optimizes, and the full-size original the viewer opens. */
const shots = {
  search: { image: search, full: docs('search') },
  inbox: { image: inbox, full: docs('inbox') },
  health: { image: health, full: docs('health') },
  history: { image: history, full: docs('history') },
  assistants: { image: assistants, full: docs('assistants') },
  routines: { image: routines, full: docs('routines') },
  pdf: { image: pdf, full: demo('pdf') },
  office: { image: office, full: demo('office') },
  ocr: { image: ocr, full: demo('ocr') },
} satisfies Record<string, { image: ImageMetadata; full: string }>;
export type ShotName = keyof typeof shots;

interface Props {
  items: { shot: ShotName; title: string; text: string; alt: string }[];
  /** Accessible suffix of the links to the full-size images. */
  openLabel: string;
  /** Lightbox group: the gallery's screenshots and any other link of the same group. */
  group?: string;
}

const { items, openLabel, group = 'home' } = Astro.props;
---

<ul class="gallery">
  {
    items.map((item) => (
      <li>
        <figure>
          <a
            class="frame"
            href={shots[item.shot].full}
            data-lightbox={group}
            data-caption={`${item.title} ${item.text}`}
          >
            <Image
              src={shots[item.shot].image}
              alt={item.alt}
              widths={[560, 800, 1120]}
              sizes="(min-width: 1000px) 360px, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
            />
            <span class="sr-only">{openLabel}</span>
          </a>
          <figcaption>
            <strong>{item.title}</strong> {item.text}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  figure { margin: 0; min-width: 0; }
  .frame {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 10px 28px -14px rgb(0 0 0 / 0.18);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .frame:hover { transform: translateY(-2px); box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 16px 36px -14px rgb(0 0 0 / 0.24); }
  .frame :global(img) { display: block; width: 100%; height: auto; }
  figcaption { margin-top: var(--space-3); font-size: 14.5px; line-height: 1.5; color: var(--ink-2); }
  figcaption strong { color: var(--ink); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    .frame, .frame:hover { transition: none; transform: none; }
  }
</style>
