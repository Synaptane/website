---
/**
 * "Your files, all searchable": a compact band under the features. The slot holds the argument
 * (a title, two or three sentences, links); the list shows the kinds of files a space displays
 * and searches, one chip each. The detailed matrix (what the wiki shows, what search finds, what
 * assistants get, per format) lives in the documentation, docs/guide/wiki.md ("Files other
 * than Markdown"), and in the README of synaptane/synaptane: keep the chips in sync with them.
 */
import HomeIcon, { type HomeIconName } from './HomeIcon.astro';

export interface FileFormat {
  icon: HomeIconName;
  name: string;
}

interface Props {
  items: FileFormat[];
  /** Accessible name of the list of formats. */
  label: string;
  id?: string;
}

const { items, label, id } = Astro.props;
---

<div class="files" id={id}>
  <div class="text"><slot /></div>
  <ul class="formats" aria-label={label}>
    {
      items.map((f) => (
        <li>
          <HomeIcon name={f.icon} size={16} />
          <span>{f.name}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .files {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: var(--radius-lg);
    background: linear-gradient(var(--accent-soft), var(--accent-soft)), var(--surface);
    scroll-margin-top: var(--space-8);
  }
  @media (min-width: 960px) {
    .files {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: center;
      padding: var(--space-6);
    }
  }
  .text :global(h3) { margin: 0 0 var(--space-2); font-size: 18px; }
  .text :global(p) { margin: 0 0 var(--space-3); max-width: 62ch; color: var(--ink-2); font-size: 15px; line-height: 1.55; }
  .text :global(p:last-child) { margin-bottom: 0; }
  .formats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .formats li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.3;
  }
  .formats :global(svg) { flex: none; color: var(--accent); }
</style>
