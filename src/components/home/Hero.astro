---
/**
 * Top of the home page: status line, two-part headline, one-sentence lead, actions (slot
 * "actions"), then the product screenshot (light and dark), framed like a window.
 */
import Screenshot from '../Screenshot.astro';
import wikiLight from '../../assets/app/wiki-light.png';
import wikiDark from '../../assets/app/wiki-dark.png';
import { SITE } from '../../site';

interface Props {
  /** Small line above the headline (status, version). */
  status: string;
  /** Link of the status line. */
  statusHref: string;
  /** First part of the headline (ink). */
  title: string;
  /** Second part of the headline (muted). */
  titleMuted: string;
  lead: string;
  screenshotAlt: string;
  /** Text under the screenshot. */
  caption: string;
}

const { status, statusHref, title, titleMuted, lead, screenshotAlt, caption } = Astro.props;
---

<section class="hero">
  <div class="container hero-text">
    <a class="status" href={statusHref}>
      <span class="status-dot" aria-hidden="true"></span>
      <span>{status}</span>
      <span class="status-version">{SITE.version}</span>
    </a>
    <h1>
      <span class="title">{title}</span>
      <span class="title-muted">{titleMuted}</span>
    </h1>
    <p class="lead">{lead}</p>
    <div class="actions"><slot name="actions" /></div>
  </div>
  <div class="container hero-shot">
    <Screenshot
      light={wikiLight}
      dark={wikiDark}
      alt={screenshotAlt}
      eager
      sizes="(min-width: 1184px) 1120px, calc(100vw - 32px)"
    />
    <p class="shot-caption">{caption}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 8vw, 88px);
    /* The lower part of the screenshot sits on the next band (the journey section). */
    background: linear-gradient(to bottom, var(--bg) 0, var(--bg) calc(100% - 22vw), var(--surface) calc(100% - 22vw));
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  @media (min-width: 1184px) {
    .hero { background: linear-gradient(to bottom, var(--bg) 0, var(--bg) calc(100% - 260px), var(--surface) calc(100% - 260px)); }
  }
  /* A faint dotted grid behind the headline. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 40% 0;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 9%, transparent) 1px, transparent 1.2px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 30% 20%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 30% 20%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-text { position: relative; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-5);
    padding: 4px 6px 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
  }
  .status:hover { color: var(--ink); border-color: var(--field-border); }
  .status-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--warn-ink); }
  .status-version {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--bg-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-2);
  }
  h1 {
    /* Wide enough for longer languages (French): lines are balanced rather than cut short. */
    max-width: 30ch;
    margin-bottom: var(--space-5);
    font-size: clamp(38px, 6.4vw, 66px);
    line-height: 1.03;
    letter-spacing: -0.035em;
  }
  .title, .title-muted { display: block; text-wrap: balance; }
  .title-muted { color: var(--ink-3); }
  .lead { max-width: 60ch; margin: 0; font-size: clamp(17px, 2vw, 19.5px); line-height: 1.55; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-6) 0 0; }
  .hero-shot { position: relative; margin-top: clamp(40px, 6vw, 64px); padding-bottom: var(--space-6); }
  .shot-caption { margin: var(--space-3) 0 0; font-size: 13.5px; color: var(--ink-3); text-align: center; }
  @media (max-width: 479px) {
    .actions > :global(*) { flex: 1 1 auto; }
  }
</style>
