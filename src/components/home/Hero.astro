---
/**
 * Top of the home page: status line, two-part headline, one-sentence lead, actions (slot
 * "actions"), an optional line of short reassurances under them, then the product screenshot
 * (light and dark, in the page's language; on phones, the same page taken on a phone), framed
 * like a window.
 */
import Screenshot from '../Screenshot.astro';
import { getLang } from '../../i18n';
import { shot } from '../../lib/screenshots';
import { SITE } from '../../site';
import { isPrerelease, releaseStatus } from '../../lib/release';

interface Props {
  /** Small line above the headline (status, version): releaseLabel() of src/lib/release.ts. */
  status: string;
  /** Link of the status line. */
  statusHref: string;
  /** First part of the headline (ink). */
  title: string;
  /** Second part of the headline (muted). */
  titleMuted: string;
  lead: string;
  /** Short facts under the actions (licence, hosting…), each after a small check mark. */
  points?: string[];
  screenshotAlt: string;
  /** Text under the screenshot. */
  caption: string;
}

const { status, statusHref, title, titleMuted, lead, points = [], screenshotAlt, caption } = Astro.props;
// Colour of the dot: green for a released stable version, amber for a pre-release, grey while
// the version is still to come.
const release = await releaseStatus();
const tone = isPrerelease(release) ? 'preview' : release.date ? 'stable' : 'upcoming';
const lang = getLang(Astro.currentLocale);
const wiki = shot('wiki', lang);
const wikiPhone = shot('wiki', lang, 'mobile');
---

<section class="hero">
  <div class="container hero-text">
    <a class="status" href={statusHref}>
      <span class={`status-dot status-dot-${tone}`} aria-hidden="true"></span>
      <span>{status}</span>
      <span class="status-version">{SITE.version}</span>
    </a>
    <h1>
      <span class="title">{title}</span>
      <span class="title-muted">{titleMuted}</span>
    </h1>
    <p class="lead">{lead}</p>
    <div class="actions"><slot name="actions" /></div>
    {points.length > 0 && (
      <ul class="points">
        {points.map((point) => <li>{point}</li>)}
      </ul>
    )}
  </div>
  <div class="container hero-shot">
    <Screenshot
      light={wiki.light}
      dark={wiki.dark}
      mobile={wikiPhone}
      alt={screenshotAlt}
      eager
      sizes="(min-width: 1184px) 1120px, calc(100vw - 32px)"
      zoom="home"
      zoomCaption={caption}
    />
    <p class="shot-caption">{caption}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 8vw, 88px);
    /* The lower part of the screenshot sits on the next band (the journey section). */
    background: linear-gradient(to bottom, var(--bg) 0, var(--bg) calc(100% - 22vw), var(--surface) calc(100% - 22vw));
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  @media (min-width: 1184px) {
    .hero { background: linear-gradient(to bottom, var(--bg) 0, var(--bg) calc(100% - 260px), var(--surface) calc(100% - 260px)); }
  }
  /* A faint dotted grid behind the headline. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 40% 0;
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 9%, transparent) 1px, transparent 1.2px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 30% 20%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 30% 20%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-text { position: relative; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-5);
    padding: 4px 6px 4px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
  }
  .status:hover { color: var(--ink); border-color: var(--field-border); }
  .status-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--ink-3); }
  .status-dot-stable { background: var(--ok); }
  .status-dot-preview { background: var(--warn-ink); }
  .status-version {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--bg-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-2);
  }
  h1 {
    /* Wide enough for longer languages (French): lines are balanced rather than cut short. */
    max-width: 30ch;
    margin-bottom: var(--space-5);
    font-size: clamp(38px, 6.4vw, 66px);
    line-height: 1.03;
    letter-spacing: -0.035em;
  }
  /* Phones: a smaller floor, so that the French title stays at four or five lines at 360px and
     the buttons stay in the first screen. */
  @media (max-width: 599px) {
    h1 { font-size: clamp(31px, 8.6vw, 38px); letter-spacing: -0.03em; }
  }
  .title, .title-muted { display: block; text-wrap: balance; }
  .title-muted { color: var(--ink-3); }
  .lead { max-width: 60ch; margin: 0; font-size: clamp(17px, 2vw, 19.5px); line-height: 1.55; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-6) 0 0; }
  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--ink-3);
  }
  /* A small check mark drawn in CSS: it stays in front of each fact when the line wraps. */
  .points li::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 8px;
    margin: 0 8px 0 2px;
    border: solid var(--ok);
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-2px) rotate(45deg);
  }
  .hero-shot { position: relative; margin-top: clamp(40px, 6vw, 64px); padding-bottom: var(--space-6); }
  .shot-caption { margin: var(--space-3) 0 0; font-size: 13.5px; color: var(--ink-3); text-align: center; }
  /* Phones: the buttons are stacked at full width, like every group of buttons of the site pages. */
  @media (max-width: 479px) {
    .actions { flex-direction: column; align-items: stretch; }
  }
</style>
