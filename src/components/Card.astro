---
/**
 * A card (the application's .card): title, text in the slot, optional icon slot and link.
 * With `href`, the whole card is clickable (the title is the link); `action` adds a short verb
 * under the text, followed by an arrow ("Open →"), so that the card reads as a link at a glance.
 *
 *   <Card title="Stored in Git" href="/docs/concepts/">Plain Markdown in your repository.</Card>
 */
interface Props {
  title: string;
  href?: string;
  /** Heading level of the title (h3 by default). */
  level?: 2 | 3 | 4;
  /** With `href`: label shown at the bottom of the card ("Open"), before an arrow. Visual only:
   *  the title is the link that screen readers announce. */
  action?: string;
  class?: string;
}

const { title, href, level = 3, action, class: className } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
---

<article class:list={['card', { 'card-link': href }, className]}>
  {Astro.slots.has('icon') && <div class="card-icon"><slot name="icon" /></div>}
  <Heading class="card-title">{href ? <a href={href}>{title}</a> : title}</Heading>
  <div class="card-body"><slot /></div>
  {href && action && <p class="card-action" aria-hidden="true">{action} <span>→</span></p>}
</article>

<style>
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .card-link:hover { border-color: var(--field-border); }
  .card-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--space-3);
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .card-title { font-size: 17px; margin-bottom: var(--space-2); }
  .card-title a { color: var(--ink); text-decoration: none; }
  /* The link covers the whole card. */
  .card-title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card-title a:focus-visible { outline: none; }
  .card-link:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card-body { color: var(--ink-2); font-size: 15px; }
  .card-body :global(p:last-child) { margin-bottom: 0; }
  /* At the bottom of the card, whatever the length of the text: the actions of a row line up. */
  .card-action { margin: auto 0 0; padding-top: var(--space-4); color: var(--accent); font-size: 14px; font-weight: 500; }
  .card-action span { display: inline-block; transition: transform 0.15s; }
  .card-link:hover .card-action { text-decoration: underline; }
  .card-link:hover .card-action span { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) { .card-action span { transition: none; } }
</style>
